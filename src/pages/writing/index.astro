---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || b.id.localeCompare(a.id));
const themes = [
  { key: 'writing', zh: '写作', en: 'Writing' },
  { key: 'tools', zh: '工具', en: 'Tools' },
  { key: 'systems', zh: '系统', en: 'Systems' },
  { key: 'notes', zh: '随笔', en: 'Notes' },
];
const zhThemes = themes.filter((theme) => posts.some((post) => post.data.language === 'zh' && post.data.theme === theme.key));
const enThemes = themes.filter((theme) => posts.some((post) => post.data.language === 'en' && post.data.theme === theme.key));
const readMinutes = (body: string) => Math.max(1, Math.ceil(body.replace(/\s/g, '').length / 500));
---

<BaseLayout title="文章 — laconicleon" description="Leon Reed / 简练的文章归档。">
  <main>
    <SiteHeader active="writing" />
    <section class="intro"><h1><span class="zh">文章</span><span class="en" hidden>Writing</span></h1><p class="zh">把正在形成的想法，写成可以回看的文字。</p><p class="en" hidden>Notes on clear thinking, durable systems, and careful work.</p></section>
    {enThemes.length > 0 && <button class="language-notice zh" id="show-english">另有英文原文，切换至英文版查看 →</button>}
    {zhThemes.length > 0 && <button class="language-notice en" id="show-chinese" hidden>Chinese originals available — switch to Chinese →</button>}
    <section class="library">
      <div class="tools"><label><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="搜索文章" /></label><div class="filters"><button class="filter active" data-filter="all"><span class="zh">全部</span><span class="en" hidden>All</span></button>{zhThemes.map((theme) => <button class="filter zh" data-filter={theme.key}>{theme.zh}</button>)}{enThemes.map((theme) => <button class="filter en" data-filter={theme.key} hidden>{theme.en}</button>)}</div></div>
      <div class="list">
        {posts.map((post) => <a class="post" href={`/writing/${post.id}`} data-language={post.data.language} data-theme={post.data.theme}><time>{post.data.publishedAt.toLocaleDateString(post.data.language === 'zh' ? 'zh-CN' : 'en-GB', { year:'numeric', month:'2-digit', day:'2-digit' }).replaceAll('/','.')}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><small>{readMinutes(post.body ?? '')} <span class="zh">分钟阅读</span><span class="en" hidden>min read</span></small><b aria-hidden="true">→</b></a>)}
      </div>
    </section>
    <p class="empty" hidden><span class="zh">没有找到匹配的文章。</span><span class="en" hidden>No matching essays found.</span></p>
  </main>
  <script>
    let language: 'zh' | 'en' = localStorage.getItem('laconicleon-language') === 'en' ? 'en' : 'zh';
    let filter = 'all'; let query = '';
    const rows = [...document.querySelectorAll<HTMLElement>('.post')];
    const refresh = () => {
      document.documentElement.lang = language === 'en' ? 'en' : 'zh-CN';
      document.querySelectorAll<HTMLElement>('.zh,.en').forEach((node) => node.toggleAttribute('hidden', language === 'en' ? node.classList.contains('zh') : node.classList.contains('en')));
      document.querySelector<HTMLInputElement>('#search')!.placeholder = language === 'en' ? 'Search writing' : '搜索文章';
      let shown = 0;
      rows.forEach((row) => { const matches = row.dataset.language === language && (filter === 'all' || row.dataset.theme === filter) && row.textContent?.toLowerCase().includes(query); row.toggleAttribute('hidden', !matches); if (matches) shown += 1; });
      document.querySelector<HTMLElement>('.empty')?.toggleAttribute('hidden', shown !== 0);
      localStorage.setItem('laconicleon-language', language);
    };
    document.querySelector<HTMLInputElement>('#search')?.addEventListener('input', (event) => { query = (event.currentTarget.value || '').toLowerCase(); refresh(); });
    document.querySelectorAll<HTMLButtonElement>('.filter').forEach((button) => button.addEventListener('click', () => { filter = button.dataset.filter || 'all'; document.querySelectorAll('.filter').forEach((item) => item.classList.toggle('active', item === button)); refresh(); }));
    const resetFilter = () => { filter = 'all'; document.querySelectorAll('.filter').forEach((item) => item.classList.toggle('active', item.dataset.filter === 'all')); };
    document.addEventListener('laconicleon:languagechange', ((event: CustomEvent<{ language: 'zh' | 'en' }>) => { language = event.detail.language; resetFilter(); refresh(); }) as EventListener);
    const setLanguage = (value: 'zh' | 'en') => (window as typeof window & { setLaconicleonLanguage?: (language: 'zh' | 'en') => void }).setLaconicleonLanguage?.(value);
    refresh();
    document.querySelector('#show-english')?.addEventListener('click', () => setLanguage('en'));
    document.querySelector('#show-chinese')?.addEventListener('click', () => setLanguage('zh'));
  </script>
</BaseLayout>

<style>
  [hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}.intro{padding:68px 4% 46px;border-bottom:1px solid var(--ink)}.intro h1{font:500 clamp(58px,8vw,106px)/1 var(--serif);letter-spacing:-.08em;margin:0}.intro p{margin:22px 0 0;font:17px var(--serif);color:var(--muted)}.language-notice{width:100%;margin:0;padding:14px 4%;border:0;border-bottom:1px solid var(--ink);background:transparent;text-align:left;color:var(--accent);font:13px var(--mono);cursor:pointer}.library{max-width:1120px;margin:0 auto;padding:35px 0 90px}.tools{border-bottom:1px solid var(--ink)}label{height:58px;border:1px solid var(--ink);display:flex;align-items:center;padding:0 18px;gap:12px}label span{font:34px/1 var(--serif)}input{width:100%;border:0;outline:0;background:transparent;font:18px var(--serif)}.filters{display:flex;gap:31px;padding:21px 0 13px;overflow:auto}.filter{border:0;background:none;padding:0;cursor:pointer;font:16px var(--serif);white-space:nowrap}.filter.active{color:var(--accent);border-bottom:2px solid var(--accent);padding-bottom:10px}.post{display:grid;grid-template-columns:140px minmax(0,1fr) 100px 24px;gap:22px;align-items:center;padding:28px 9px;border-bottom:1px solid var(--line)}.post:hover{background:#fafafa}.post time{font:13px var(--mono);color:var(--accent)}.post h2{font:500 28px/1.25 var(--serif);margin:0;overflow-wrap:anywhere}.post p{font:16px/1.55 var(--serif);color:var(--muted);margin:8px 0 0}.post small{font:12px var(--mono);color:var(--muted)}.post b{font:24px var(--sans);font-weight:400}.empty{margin:0 4% 90px;font:18px var(--serif);color:var(--muted)}@media(max-width:760px){main{padding:0 20px}.intro{padding:49px 0 34px}.intro h1{font-size:clamp(54px,18vw,67px)}.language-notice{padding:14px 0}.library{display:block;padding:25px 0 58px}.filters{gap:22px}.post{grid-template-columns:minmax(0,1fr) 20px;padding:21px 0}.post time,.post small{display:none}.post h2{font-size:21px}}</style>
