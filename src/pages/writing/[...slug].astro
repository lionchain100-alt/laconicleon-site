---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allPosts = await getCollection('posts');
export async function getStaticPaths() { return (await getCollection('posts')).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const isZh = post.data.language === 'zh';
const languagePosts = allPosts.filter((entry) => !entry.data.draft && entry.data.language === post.data.language).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const position = languagePosts.findIndex((entry) => entry.id === post.id);
const newer = languagePosts[position - 1];
const older = languagePosts[position + 1];
const related = languagePosts.filter((entry) => entry.id !== post.id && entry.data.tags.some((tag) => post.data.tags.includes(tag))).slice(0, 3);
const translation = post.data.translationKey ? allPosts.find((entry) => entry.data.translationKey === post.data.translationKey && entry.data.language !== post.data.language) : undefined;
const date = post.data.publishedAt.toLocaleDateString(isZh ? 'zh-CN' : 'en-GB', { year:'numeric', month:'long', day:'numeric' });
const minutes = Math.max(1, Math.ceil((post.body ?? '').replace(/\s/g, '').length / 500));
---
<BaseLayout
  title={`${post.data.title} — laconicleon`}
  description={post.data.description}
  lang={isZh ? 'zh-CN' : 'en'}
  canonicalPath={`/writing/${post.id}/`}
  image={post.data.cover}
  type="article"
>
  <div class="progress" aria-hidden="true"><i></i></div>
  <article>
    <header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><a class="back" href="/writing">← {isZh ? '返回文章' : 'Back to writing'}</a></header>
    <div class="progress-label"><span>{isZh ? '阅读进度' : 'Reading progress'}</span><i></i></div>
    <div class="mast"><p>{isZh ? '写作 / 简练' : 'Writing / Leon Reed'}</p><h1>{post.data.title}</h1><div class="metadata"><span>{date}</span><span>{minutes} {isZh ? '分钟阅读' : 'min read'}</span><span>{post.data.tags.join(' · ')}</span></div>{translation && <a class="translation" href={`/writing/${translation.id}`}>{isZh ? '阅读英文版 ↗' : 'Read in Chinese ↗'}</a>}</div>
    {post.data.cover && <figure class="cover"><img src={`${post.data.cover}?v=${post.data.publishedAt.getTime()}`} alt={post.data.title} loading="eager" /></figure>}
    <div class="reading">
      <aside class="toc"><p>{isZh ? '目录' : 'Contents'}</p>{headings.length ? headings.filter((heading) => heading.depth <= 3).map((heading) => <a class:list={[`level-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>) : <span>{isZh ? '本文' : 'Essay'}</span>}</aside>
      <div class="body"><Content /></div>
    </div>
    <section class="after">
      <div class="neighbours"><a class:list={{ muted: !newer }} href={newer ? `/writing/${newer.id}` : undefined}><small>{isZh ? '上一篇' : 'Previous'}</small><strong>{newer?.data.title ?? '—'}</strong><b>←</b></a><a class:list={{ muted: !older }} href={older ? `/writing/${older.id}` : undefined}><small>{isZh ? '下一篇' : 'Next'}</small><strong>{older?.data.title ?? '—'}</strong><b>→</b></a></div>
      {related.length > 0 && <div class="related"><p>{isZh ? '相关写作' : 'Related writing'}</p>{related.map((entry) => <a href={`/writing/${entry.id}`}>{entry.data.title}<b>→</b></a>)}</div>}
    </section>
  </article>
  <script>
    const bar = document.querySelector<HTMLElement>('.progress i');
    const update = () => { const height = document.documentElement.scrollHeight - window.innerHeight; if (bar) bar.style.width = `${height > 0 ? Math.min(100, window.scrollY / height * 100) : 0}%`; };
    addEventListener('scroll', update, { passive: true }); update();
  </script>
</BaseLayout>
<style>
  article{max-width:1390px;margin:0 auto;padding:28px 48px 92px;font-family:var(--serif)}.progress{position:fixed;z-index:5;top:0;left:0;width:100%;height:3px;background:#e7e7e7}.progress i{display:block;width:0;height:100%;background:var(--accent);transition:width .08s linear}header{height:62px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:12px;font:500 26px var(--display)}.brand img{width:28px;height:39px;object-fit:contain}.back{margin-left:auto;color:var(--accent);font:14px var(--serif)}.progress-label{max-width:920px;margin:25px auto 0;display:flex;align-items:center;gap:24px;font:12px var(--mono)}.progress-label i{height:1px;flex:1;background:var(--line)}.mast{max-width:920px;margin:62px auto 46px}.mast>p{font:13px var(--mono);letter-spacing:.08em;color:var(--accent)}h1{font:500 clamp(46px,6.1vw,81px)/1.15 var(--serif);letter-spacing:-.06em;margin:18px 0 26px}.metadata{display:flex;flex-wrap:wrap;gap:0;font:13px var(--serif)}.metadata span+span{border-left:1px solid var(--line);margin-left:15px;padding-left:15px}.translation{display:inline-block;margin-top:27px;color:var(--accent);font:14px var(--sans);border-bottom:1px solid var(--accent);padding-bottom:5px}.cover{max-width:1110px;margin:0 auto 58px;border:1px solid var(--ink);background:#eeece6}.cover img{display:block;width:100%;max-height:650px;object-fit:cover}.reading{display:grid;grid-template-columns:190px minmax(0,760px);gap:58px;max-width:1110px;margin:0 auto}.toc{position:sticky;top:35px;align-self:start;border-top:1px solid var(--ink);padding-top:14px}.toc p{font:14px var(--serif);margin:0 0 14px}.toc a,.toc span{display:block;font:13px/1.7 var(--serif);color:var(--muted);margin:8px 0}.toc a:hover{color:var(--accent)}.toc .level-3{padding-left:12px}.body{font-size:20px;line-height:2.08}.body :global(h2){font:500 34px/1.35 var(--serif);margin:75px 0 20px}.body :global(h3){font:500 25px/1.35 var(--serif);margin:46px 0 16px}.body :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:4px}.body :global(p){margin:0 0 26px}.after{max-width:1110px;margin:86px auto 0;border-top:1px solid var(--ink)}.neighbours{display:grid;grid-template-columns:1fr 1fr}.neighbours a{min-height:150px;padding:27px 45px;display:grid;grid-template-columns:1fr 26px;align-content:center;gap:7px;border-bottom:1px solid var(--ink)}.neighbours a+a{border-left:1px solid var(--ink)}.neighbours small{font:12px var(--mono);color:var(--accent)}.neighbours strong{font:500 25px/1.35 var(--serif)}.neighbours b{grid-column:2;grid-row:1/3;align-self:center;font:25px var(--sans);font-weight:400}.neighbours .muted{opacity:.36;pointer-events:none}.related{padding:30px 45px;border-bottom:1px solid var(--ink)}.related p{font:13px var(--mono);color:var(--accent);margin:0 0 15px}.related a{display:flex;justify-content:space-between;padding:10px 0;font:17px var(--serif);border-top:1px solid var(--line)}.related b{font:22px var(--sans);font-weight:400}@media(max-width:740px){article{padding:18px 22px 65px}.mast{margin:50px 0 35px}.progress-label{margin-top:18px}h1{font-size:45px}.metadata{font-size:12px}.cover{margin-bottom:40px}.cover img{max-height:none}.reading{display:block}.toc{position:static;margin-bottom:35px}.toc a{display:none}.body{font-size:18px}.body :global(h2){font-size:28px;margin-top:55px}.after{margin-top:60px}.neighbours{display:block}.neighbours a{padding:24px 0}.neighbours a+a{border-left:0}.related{padding:25px 0}.brand{font-size:23px}}</style>
