---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
const allPosts = await getCollection('posts');
export async function getStaticPaths() { return (await getCollection('posts')).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props; const { Content } = await render(post);
const translation = post.data.translationKey ? allPosts.find((entry) => entry.data.translationKey === post.data.translationKey && entry.data.language !== post.data.language) : undefined;
const date = post.data.publishedAt.toLocaleDateString(post.data.language === 'zh' ? 'zh-CN' : 'en-GB', { year:'numeric', month:'long', day:'numeric' });
---
<BaseLayout title={`${post.data.title} — laconicleon`}>
  <article><header><a class="back" href="/">← {post.data.language === 'zh' ? '返回写作' : 'Back to writing'}</a><img src="/brand-seal-vertical.png" alt="练" /><time>{date}</time></header><div class="mast"><p>{post.data.language === 'zh' ? '写作 / 简练' : 'Writing / Leon Reed'}</p><h1>{post.data.title}</h1><div class="rule"></div>{translation && <a class="translation" href={`/writing/${translation.id}`}>{post.data.language === 'zh' ? '阅读英文版 ↗' : 'Read in Chinese ↗'}</a>}</div><div class="reading"><aside>{post.data.tags.slice(0,3).map((tag) => <span>{tag}</span>)}</aside><div class="body"><Content /></div></div></article>
</BaseLayout>
<style>article{max-width:1240px;margin:0 auto;padding:28px 48px 100px;font-family:var(--serif)}header{height:62px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}header img{width:28px;height:39px;object-fit:contain;margin:auto}header time{font:12px var(--mono)}.back{font:14px var(--serif);color:var(--accent)}.mast{max-width:820px;margin:112px auto 64px}.mast>p{font:13px var(--mono);letter-spacing:.08em;color:var(--accent)}h1{font:500 clamp(48px,6vw,82px)/1.15 var(--serif);letter-spacing:-.055em;margin:18px 0 28px}.rule{width:96px;border-top:3px solid var(--accent);transform:rotate(-2deg)}.translation{display:inline-block;margin-top:30px;color:var(--accent);font:15px var(--sans);border-bottom:1px solid var(--accent);padding-bottom:5px}.reading{display:grid;grid-template-columns:150px minmax(0,720px);gap:44px;max-width:1010px;margin:0 auto}.reading aside{padding-top:11px;border-top:1px solid var(--ink);font:12px/2 var(--mono);color:var(--muted)}.reading aside span{display:block}.body{font-size:20px;line-height:2.05}.body :global(h2){font:500 32px/1.35 var(--serif);margin:72px 0 20px}.body :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:4px}.body :global(p){margin:0 0 26px}@media(max-width:700px){article{padding:18px 22px 70px}.mast{margin:72px 0 46px}h1{font-size:48px}.reading{display:block}.reading aside{display:flex;gap:12px;margin-bottom:32px}.reading aside span{display:inline}.body{font-size:18px}.body :global(h2){font-size:27px}}</style>
