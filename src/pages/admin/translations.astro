---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="文章翻译 — laconicleon" indexable={false}>
  <main class="workspace">
    <header class="topbar"><a href="/admin/">← 编辑后台</a><h1>文章翻译</h1><span id="account">正在检查登录…</span></header>
    <section class="board">
      <aside class="rail"><p>翻译方向</p><button class="active">英 → 中 / 中文编辑</button><hr/><strong>两稿工作流</strong><small>系统先生成语义参考稿，再写成可发布的中文成稿。参考稿只用于核对，最终仍由你审核后保存为草稿。</small></aside>
      <section class="list"><div class="list-head"><div><h2>英文文章</h2><p id="notice">正在读取文章…</p></div><button id="refresh">↻ 刷新</button></div><div id="posts"></div></section>
      <aside id="inspector" class="inspector"><div class="empty"><span>练</span><h2>选择一篇英文文章</h2><p>系统会检查是否已有对应中文版本。</p></div></aside>
    </section>
  </main>
  <template id="inspector-template">
    <div class="inspect-head"><div><p>ENGLISH ORIGINAL</p><h2 data-title></h2></div><button data-close>×</button></div>
    <dl><div><dt>发布日期</dt><dd data-date></dd></div><div><dt>翻译编号</dt><dd data-key></dd></div><div><dt>状态</dt><dd data-state></dd></div></dl>
    <p class="summary" data-description></p>
    <button class="generate" data-generate>生成中文成稿 <span>→</span></button>
    <p class="hint">会先生成可编辑的中文成稿，再由你保存为草稿。原发布日期、封面图与翻译编号会保留。</p>
    <div class="result" data-result hidden></div>
  </template>
  <script is:inline>
    const OWNER='lionchain100-alt', REPO='laconicleon-site', ROOT=`https://api.github.com/repos/${OWNER}/${REPO}`;
    const state={token:'',posts:[],active:null}; const $=(s,p=document)=>p.querySelector(s);
    const decode=v=>decodeURIComponent(Array.prototype.map.call(atob(v.replace(/\n/g,'')),c=>`%${`00${c.charCodeAt(0).toString(16)}`.slice(-2)}`).join(''));
    const encode=v=>btoa(unescape(encodeURIComponent(v)));
    const token=()=>{for(const raw of [localStorage.getItem('netlify-cms-user'),...Object.keys(localStorage).map(k=>localStorage.getItem(k))])try{const value=JSON.parse(raw);const t=value?.token||value?.access_token||value?.backend?.token;if(typeof t==='string'&&t.length>20)return t}catch{}return ''};
    async function github(path,opts={}){const response=await fetch(path.startsWith('http')?path:`${ROOT}${path}`,{...opts,headers:{Accept:'application/vnd.github+json',Authorization:`Bearer ${state.token}`,...(opts.headers||{})}});if(!response.ok)throw new Error(response.status===401?'GitHub 登录已过期，请重新登录后台。':`GitHub 请求失败（${response.status}）。`);return response.json()}
    function frontmatter(raw){const match=raw.match(/^---\s*\n([\s\S]*?)\n---\s*\n([\s\S]*)$/);if(!match)return null;const data={};match[1].split('\n').forEach(line=>{const i=line.indexOf(':');if(i>0)data[line.slice(0,i).trim()]=line.slice(i+1).trim().replace(/^['"]|['"]$/g,'')});return{data,body:match[2]}}
    function safe(value=''){return String(value).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
    function chineseFor(post){return state.posts.find(other=>other.data.language==='zh'&&!other.data.revisionOf&&other.data.translationKey&&other.data.translationKey===post.data.translationKey)}
    function revisionFor(post){return state.posts.find(other=>other.data.language==='zh'&&other.data.revisionOf===post.path)}
    function hasChinese(post){return Boolean(chineseFor(post)||revisionFor(post))}
    function render(){const holder=$('#posts');const english=state.posts.filter(post=>post.data.language==='en'&&!/^true$/i.test(post.data.draft||'')).sort((a,b)=>String(b.data.publishedAt||'').localeCompare(String(a.data.publishedAt||''))||b.path.localeCompare(a.path));holder.innerHTML=english.length?english.map(post=>{const done=hasChinese(post);return `<button class="post ${state.active?.path===post.path?'selected':''}" data-path="${safe(post.path)}"><time>${safe(post.data.publishedAt||'未设日期')}</time><span><strong>${safe(post.data.title||post.name)}</strong><small>${safe(post.data.description||'')}</small></span><i class="${done?'done':''}">${done?'已有中文稿':'待翻译'}</i><b>→</b></button>`}).join(''):'<p class="no-post">没有可翻译的已发布英文文章。</p>';holder.querySelectorAll('.post').forEach(button=>button.addEventListener('click',()=>open(state.posts.find(post=>post.path===button.dataset.path))))}
    async function load(){state.token=token();if(!state.token){$('#account').textContent='请先登录编辑后台';$('#notice').innerHTML='请先打开 <a href="/admin/">编辑后台</a> 登录 GitHub。';return}try{const user=await github('https://api.github.com/user');if(user.login!==OWNER)throw new Error('当前 GitHub 账户不是网站所有者。');$('#account').textContent=`GitHub / ${user.login}`;const files=await github('/contents/src/content/posts');state.posts=[];for(const file of files.filter(file=>/\.mdx?$/.test(file.name))){const content=await github(`/contents/${file.path}`);const parsed=frontmatter(decode(content.content));if(parsed)state.posts.push({...file,...parsed,sha:content.sha})}$('#notice').textContent=`共找到 ${state.posts.filter(post=>post.data.language==='en').length} 篇英文文章。`;render()}catch(error){$('#notice').textContent=error.message||'无法读取文章。'}}
    function slugify(source){return `zh-${String(source.data.slug||source.name.replace(/\.mdx?$/,'')).replace(/^\d{4}-\d{2}-\d{2}-/,'').replace(/[^a-z0-9-]/gi,'-').replace(/-+/g,'-').replace(/^-|-$/g,'')}`}
    function yaml(value){return String(value||'').replace(/"/g,'\\"')}
    function compose(source, translated, { draft=true, revisionOf='' }={}){const tags=(translated.tags||[]).map(tag=>`  - ${yaml(tag)}`).join('\n');return `---\ntitle: "${yaml(translated.title)}"\ndescription: "${yaml(translated.description)}"\npublishedAt: ${source.data.publishedAt||new Date().toISOString().slice(0,10)}\ndraft: ${draft}\nfeatured: false\ncategory: 写作\n${source.data.cover?`cover: ${source.data.cover}\n`:''}tags:\n${tags||'  - 写作'}\nlanguage: zh\ntranslationKey: ${source.data.translationKey||slugify(source)}\n${revisionOf?`revisionOf: ${revisionOf}\n`:''}---\n\n${translated.body.trim()}\n`}
    async function open(post){if(!post)return;state.active=post;render();const panel=$('#inspector');panel.innerHTML='';panel.append($('#inspector-template').content.cloneNode(true));const chinese=chineseFor(post),revision=revisionFor(post),published=chinese&&!/^true$/i.test(chinese.data.draft||'');panel._target={chinese,revision,published};$('[data-title]',panel).textContent=post.data.title||post.name;$('[data-date]',panel).textContent=post.data.publishedAt||'未设日期';$('[data-key]',panel).textContent=post.data.translationKey||slugify(post);$('[data-state]',panel).textContent=published&&revision?'已有发布版本与修订草稿':published?'已有已发布中文版本，可创建修订草稿':revision?'已有修订草稿，可重新生成':chinese?'已有中文草稿，可重新生成':'尚未翻译';$('[data-description]',panel).textContent=post.data.description||'';const generate=$('[data-generate]',panel);if(published)generate.innerHTML='生成修订中文稿 <span>→</span>';else if(chinese||revision)generate.innerHTML='重新生成中文成稿 <span>→</span>'; $('[data-close]',panel).addEventListener('click',()=>{state.active=null;render();panel.innerHTML='<div class="empty"><span>练</span><h2>选择一篇英文文章</h2><p>系统会检查是否已有对应中文版本。</p></div>'});generate.onclick=()=>translate(post,panel)}
    async function translate(post,panel){const button=$('[data-generate]',panel),result=$('[data-result]',panel),controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),90000);button.disabled=true;button.textContent='正在生成中文成稿…';result.hidden=false;result.textContent='正在按中文写作习惯重写文章；较长文章通常需要几十秒。';try{const response=await fetch('/api/translate-post',{method:'POST',signal:controller.signal,headers:{'content-type':'application/json',Authorization:`Bearer ${state.token}`},body:JSON.stringify({title:post.data.title,description:post.data.description,body:post.body})});const translated=await response.json();if(!response.ok)throw new Error(translated.error||'生成失败。');panel._translation=translated;result.innerHTML=`<strong>中文成稿已生成。</strong><p>可以直接修改标题、摘要或正文；请对照上方英文原文核对事实，确认后再保存为草稿。</p><label>中文标题<input data-review-title value="${safe(translated.title)}" /></label><label>中文摘要<textarea data-review-description>${safe(translated.description)}</textarea></label><label>中文正文<textarea class="review-body" data-review-body>${safe(translated.body)}</textarea></label>`;button.disabled=false;button.innerHTML='保存为中文草稿 <span>→</span>';button.onclick=()=>saveDraft(post,panel)}catch(error){result.textContent=error.name==='AbortError'?'生成超过 90 秒仍未完成。请稍后重试；若持续出现，请先缩短正文或联系我检查 AI 服务。':(error.message||'生成失败。');button.disabled=false;button.innerHTML='重新生成中文成稿 <span>→</span>'}finally{clearTimeout(timeout)}}
    async function saveDraft(post,panel){const button=$('[data-generate]',panel),result=$('[data-result]',panel),base=panel._translation;if(!base)return;const translated={...base,title:$('[data-review-title]',result).value.trim(),description:$('[data-review-description]',result).value.trim(),body:$('[data-review-body]',result).value.trim()};if(!translated.title||!translated.description||!translated.body){result.insertAdjacentHTML('afterbegin','<p class="review-error">标题、摘要与正文不能为空。</p>');return}button.disabled=true;button.textContent='正在保存修订草稿…';try{const target=panel._target||{},isRevision=Boolean(target.published);const date=String(post.data.publishedAt||new Date().toISOString()).slice(0,10);const filename=isRevision?`${date}-${slugify(post)}-revision.md`:`${date}-${slugify(post)}.md`;const path=target.revision?.path||(isRevision?`src/content/posts/${filename}`:`src/content/posts/${filename}`);const existing=state.posts.find(item=>item.path===path);const content=compose(post,translated,{draft:true,revisionOf:isRevision?post.path:''});const saved=await github(`/contents/${path}`,{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify({message:`${existing?'Refresh':'Create'} Chinese ${isRevision?'revision':'translation'} draft: ${post.data.title}`,content:encode(content),...(existing?.sha?{sha:existing.sha}:{})})});panel._revision={translated,path,sha:saved.content.sha,existing,published:target.chinese};result.innerHTML=`<strong>${isRevision?'修订草稿已保存。':'中文草稿已保存。'}</strong><p>${isRevision?'线上中文版本仍保持不变。确认无误后，可在此替换它。':'它尚未公开。请前往编辑后台做最后审核，再取消“草稿”勾选。'}</p>${isRevision?'<button class="replace" data-replace>确认替换已发布版本 →</button>':'<a href="/admin/">打开编辑后台 →</a>'}`;if(isRevision)$('[data-replace]',result).onclick=()=>replacePublished(post,panel);state.posts=state.posts.filter(item=>item.path!==path);state.posts.push({name:filename,path,sha:saved.content.sha,data:{language:'zh',draft:'true',translationKey:post.data.translationKey||slugify(post),...(isRevision?{revisionOf:post.path}:{})}});render();button.disabled=true;button.textContent=isRevision?'修订草稿已保存':'中文草稿已保存'}catch(error){result.insertAdjacentHTML('afterbegin',`<p class="review-error">${safe(error.message||'保存失败。')}</p>`);button.disabled=false;button.innerHTML='保存为中文草稿 <span>→</span>'}}
    async function replacePublished(post,panel){const result=$('[data-result]',panel),revision=panel._revision;if(!revision?.published||!confirm('确认用这份修订稿替换当前线上中文文章？替换后会立即进入网站发布队列。'))return;const button=$('[data-replace]',result);button.disabled=true;button.textContent='正在替换线上版本…';try{const published=revision.published;const content=compose(post,revision.translated,{draft:false});await github(`/contents/${published.path}`,{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify({message:`Publish revised Chinese translation: ${post.data.title}`,content:encode(content),sha:published.sha})});await github(`/contents/${revision.path}`,{method:'DELETE',headers:{'content-type':'application/json'},body:JSON.stringify({message:`Remove applied Chinese revision: ${post.data.title}`,sha:revision.sha})});result.innerHTML='<strong>已替换线上中文版本。</strong><p>修订草稿已删除，网站正在发布新版本。</p>';render()}catch(error){result.insertAdjacentHTML('afterbegin',`<p class="review-error">${safe(error.message||'替换失败。')}</p>`);button.disabled=false;button.textContent='确认替换已发布版本 →'}}
    $('#refresh').addEventListener('click',load);load();
  </script>
</BaseLayout>
<style>:global(body){background:#fff;color:#171716}.workspace{max-width:1540px;margin:auto;padding:26px 34px 44px}.topbar{display:grid;grid-template-columns:240px 1fr auto;align-items:center;min-height:75px;border-bottom:1px solid #191919}.topbar>a,.topbar span{font:12px var(--mono);color:#56534e}.topbar h1{margin:0;font:500 48px/.95 var(--serif);letter-spacing:-.07em}.board{display:grid;grid-template-columns:240px minmax(480px,1.25fr) minmax(350px,.75fr);min-height:calc(100vh - 150px);border:1px solid #d9d5cc;border-top:0}.rail,.list,.inspector{padding:27px 22px}.rail{display:flex;flex-direction:column;border-right:1px solid #d9d5cc}.rail p,.inspect-head p{margin:0 0 17px;color:#b3251d;font:11px var(--mono);letter-spacing:.1em}.rail button{padding:12px;border:1px solid #d2cdc3;background:white;text-align:left;font:16px var(--serif)}.rail button.active{border-left:3px solid #b3251d}.rail hr{width:100%;margin:35px 0;border:0;border-top:1px solid #d9d5cc}.rail strong{font:500 16px var(--serif)}.rail small,.hint{margin-top:8px;color:#6b6760;font:13px/1.7 var(--serif)}.list{border-right:1px solid #d9d5cc}.list-head,.inspect-head{display:flex;justify-content:space-between;gap:15px}.list h2,.inspector h2{margin:0;font:500 28px var(--serif);letter-spacing:-.04em}.list-head p{color:#6b6760;font:13px var(--serif)}#refresh,.inspect-head button{border:0;background:transparent;color:#b3251d;cursor:pointer;font:12px var(--mono)}#posts{border-top:1px solid #191919;margin-top:20px}.post{width:100%;display:grid;grid-template-columns:105px minmax(0,1fr) 80px 18px;gap:12px;align-items:center;padding:22px 7px;border:0;border-bottom:1px solid #dedad1;background:transparent;text-align:left;cursor:pointer}.post:hover,.post.selected{background:#f5f1ea}.post time{color:#b3251d;font:11px var(--mono)}.post strong,.post small{display:block}.post strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:500 19px var(--serif)}.post small{overflow:hidden;text-overflow:ellipsis;margin-top:6px;color:#777168;font:12px var(--sans)}.post i{font:10px var(--mono);font-style:normal;color:#a07913}.post i.done{color:#4d695e}.post b{color:#b3251d;font:19px var(--sans);font-weight:400}.no-post{padding:30px 0;color:#6b6760;font:15px var(--serif)}.inspector{background:#fbfaf7}.empty{height:100%;display:grid;place-content:center;text-align:center;color:#716d65}.empty span{color:#d8d1c6;font:88px var(--serif)}.empty h2{margin:8px 0}.empty p{max-width:230px;font:14px/1.6 var(--serif)}.inspect-head button{font-size:28px;line-height:1}.inspector dl{display:grid;grid-template-columns:1fr 1fr;margin:24px 0;border-top:1px solid #d9d5cc;border-bottom:1px solid #d9d5cc}.inspector dl div{padding:12px 0}.inspector dt{color:#7b766f;font:10px var(--mono)}.inspector dd{margin:5px 0 0;font:13px var(--serif)}.summary{color:#5f5b54;font:15px/1.65 var(--serif)}.generate,.replace{display:flex;justify-content:space-between;align-items:center;width:100%;margin-top:22px;padding:15px;border:0;background:#b3251d;color:white;font:14px var(--mono);cursor:pointer}.generate:disabled,.replace:disabled{opacity:.55;cursor:default}.generate span{font-size:21px}.result{margin-top:22px;padding:16px;border:1px solid #d3cdc2;background:#fff;font:13px/1.6 var(--serif)}.result strong{color:#b3251d;font-weight:500}.result p{margin:7px 0}.result a{color:#b3251d;border-bottom:1px solid #b3251d}.result label{display:block;margin-top:16px;color:#3f3d38;font:12px var(--mono)}.result input,.result textarea{box-sizing:border-box;width:100%;margin-top:6px;border:1px solid #cfc9be;background:#fffdfa;padding:9px;color:#24231f;font:14px/1.6 var(--serif);outline-color:#b3251d}.result textarea{min-height:72px;resize:vertical}.result .review-body{min-height:300px;font-family:var(--mono);font-size:12px;line-height:1.7}.result details{margin-top:18px;border-top:1px solid #d9d5cc;padding-top:12px}.result summary{cursor:pointer;color:#b3251d;font:11px var(--mono)}.result pre{max-height:260px;overflow:auto;white-space:pre-wrap;color:#646058;font:12px/1.65 var(--serif)}.review-error{color:#b3251d!important}@media(max-width:1000px){.board{grid-template-columns:210px 1fr}.inspector{grid-column:1/-1;border-top:1px solid #d9d5cc}.list{border-right:0}}@media(max-width:650px){.workspace{padding:16px}.topbar{grid-template-columns:1fr;gap:14px;padding-bottom:15px}.topbar h1{font-size:38px}.board{display:block}.rail,.list{border-right:0;border-bottom:1px solid #d9d5cc}.rail{min-height:auto}.post{grid-template-columns:76px 1fr 18px}.post i{display:none}.post strong{font-size:16px}}</style>
