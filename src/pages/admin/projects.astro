---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="项目管理 — laconicleon" description="管理个人网站展示的 GitHub 项目。">
  <main class="workspace">
    <header class="topbar">
      <a class="back" href="/admin/">← 编辑后台</a>
      <div><p class="eyebrow">LACONICLEON / STUDIO</p><h1>项目管理</h1></div>
      <div class="account"><span id="account-dot"></span><span id="account-name">正在检查登录…</span></div>
    </header>

    <section class="manager" aria-label="GitHub 项目管理">
      <aside class="rail">
        <label class="search"><span>⌕</span><input id="search" type="search" placeholder="搜索项目" /></label>
        <div class="filters" id="filters">
          <button class="active" data-filter="all">全部 <b id="count-all">0</b></button>
          <button data-filter="public">公开仓库 <b id="count-public">0</b></button>
          <button data-filter="private">私有仓库 <b id="count-private">0</b></button>
          <button data-filter="draft">简介草稿 <b id="count-draft">0</b></button>
          <button data-filter="published">网站展示 <b id="count-published">0</b></button>
        </div>
        <p class="privacy-note"><strong>私有仓库保护</strong>README 仅在你点击生成时发送到 AI 生成草稿；不会保存、不会自动发布，也不会在网站上显示仓库链接。</p>
        <a class="github" href="https://github.com/lionchain100-alt" target="_blank" rel="noreferrer">GitHub 账户 ↗</a>
      </aside>

      <section class="repository-pane">
        <div class="pane-head"><div><p class="eyebrow">REPOSITORIES</p><h2>选择展示内容</h2></div><button id="refresh" class="text-button">↻ 刷新 GitHub</button></div>
        <p id="repository-status" class="status">正在读取你的 GitHub 项目…</p>
        <div id="repository-list" class="repository-list" aria-live="polite"></div>
      </section>

      <aside class="editor" id="editor">
        <div class="empty-editor"><span>练</span><h2>选择一个项目</h2><p>在左侧选择项目后，可以生成并编辑它在网站上的简介。</p></div>
      </aside>
    </section>
  </main>

  <template id="editor-template">
    <div class="editor-head"><div><p class="eyebrow">SHOWCASE ENTRY</p><h2 data-title></h2></div><button class="close-editor" title="关闭">×</button></div>
    <div class="repo-tags"><span data-visibility></span><span data-language></span><span data-updated></span></div>
    <section class="readme-card"><div><p class="eyebrow">README</p><p data-readme-state>尚未读取。点击下方按钮后可生成简介草稿。</p></div><button class="outline" data-generate>✦ 从 README 生成草稿</button></section>
    <p class="ai-note">生成只用于这次请求，不会存储 README。草稿需由你确认并保存。</p>
    <label>中文简介<textarea data-zh maxlength="180" placeholder="项目的中文简介"></textarea><small><span data-zh-count>0</span> / 180</small></label>
    <label>English summary<textarea data-en maxlength="260" placeholder="A concise English project summary."></textarea><small><span data-en-count>0</span> / 260</small></label>
    <label>演示链接（可选）<input data-demo type="url" placeholder="https://…" /></label>
    <label class="public-toggle"><input data-published type="checkbox" /><span><strong>在个人网站展示</strong><em>公开仓库会链接至 GitHub；私有仓库仅展示这张介绍卡，不会暴露仓库、README 或链接。</em></span></label>
    <button class="save" data-save>保存到网站仓库 <span>→</span></button>
    <p class="save-status" data-save-status></p>
  </template>

  <script is:inline>
    const OWNER = 'lionchain100-alt';
    const REPOSITORY = 'laconicleon-site';
    const SHOWCASE_PATH = 'src/data/project-showcases.json';
    const apiBase = `https://api.github.com/repos/${OWNER}/${REPOSITORY}`;
    const state = { repos: [], entries: [], sha: '', active: null, filter: 'all', query: '', token: '' };
    const $ = (selector, parent = document) => parent.querySelector(selector);
    const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[c]));
    const encodeUtf8 = value => btoa(unescape(encodeURIComponent(value)));
    const decodeUtf8 = value => decodeURIComponent(Array.prototype.map.call(atob(value.replace(/\n/g, '')), c => `%${`00${c.charCodeAt(0).toString(16)}`.slice(-2)}`).join(''));
    const formatDate = date => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(date));
    const getToken = () => {
      const direct = localStorage.getItem('netlify-cms-user');
      const candidates = direct ? [direct] : Object.keys(localStorage).map(key => localStorage.getItem(key));
      for (const raw of candidates) try {
        const value = JSON.parse(raw);
        const token = value?.token || value?.access_token || value?.backend?.token;
        if (typeof token === 'string' && token.length > 20) return token;
      } catch { /* ignore unrelated local storage */ }
      return '';
    };
    async function github(path, options = {}) {
      const response = await fetch(path.startsWith('http') ? path : `${apiBase}${path}`, {
        ...options,
        headers: { Accept: 'application/vnd.github+json', Authorization: `Bearer ${state.token}`, ...(options.headers || {}) },
      });
      if (!response.ok) throw new Error(response.status === 401 ? 'GitHub 登录已过期，请重新登录后台。' : `GitHub 请求失败（${response.status}）。`);
      return response.json();
    }
    async function githubRaw(path) {
      const response = await fetch(`https://api.github.com/repos/${OWNER}/${encodeURIComponent(path)}/readme`, {
        headers: { Accept: 'application/vnd.github.raw+json', Authorization: `Bearer ${state.token}` },
      });
      if (!response.ok) throw new Error(response.status === 404 ? '该项目没有可读取的 README。' : `读取 README 失败（${response.status}）。`);
      return response.text();
    }
    function entryFor(name) { return state.entries.find(entry => entry.name === name); }
    function statusFor(repo) { return entryFor(repo.name)?.status || 'off'; }
    function updateCounts() {
      const count = predicate => state.repos.filter(predicate).length;
      $('#count-all').textContent = count(() => true);
      $('#count-public').textContent = count(repo => !repo.private);
      $('#count-private').textContent = count(repo => repo.private);
      $('#count-draft').textContent = count(repo => statusFor(repo) === 'draft');
      $('#count-published').textContent = count(repo => statusFor(repo) === 'published');
    }
    function renderRepositories() {
      updateCounts();
      const list = $('#repository-list');
      const filtered = state.repos.filter(repo => {
        const matchesQuery = `${repo.name} ${repo.description || ''}`.toLowerCase().includes(state.query.toLowerCase());
        const matchesFilter = state.filter === 'all' || (state.filter === 'public' && !repo.private) || (state.filter === 'private' && repo.private) || statusFor(repo) === state.filter;
        return matchesQuery && matchesFilter;
      });
      list.innerHTML = filtered.length ? filtered.map(repo => {
        const entry = entryFor(repo.name); const status = statusFor(repo);
        const title = repo.name.replace(/-/g, ' ');
        return `<button class="repo-row ${state.active?.name === repo.name ? 'selected' : ''}" data-name="${escapeHtml(repo.name)}">
          <span class="repo-index">${String(state.repos.indexOf(repo) + 1).padStart(2, '0')}</span>
          <span class="repo-main"><strong>${escapeHtml(title)}</strong><small>${escapeHtml(repo.description || '暂无 GitHub 简介')}</small></span>
          <span class="badges"><i class="${repo.private ? 'private' : 'public'}">${repo.private ? '私有' : '公开'}</i><i class="state-${status}">${status === 'published' ? '展示中' : status === 'draft' ? '草稿' : '未选择'}</i></span>
          <span class="repo-date">${entry?.updatedAt ? `已同步 ${formatDate(entry.updatedAt)}` : formatDate(repo.updated_at)}</span><span class="arrow">→</span>
        </button>`;
      }).join('') : '<p class="no-results">没有符合条件的项目。</p>';
      list.querySelectorAll('[data-name]').forEach(button => button.addEventListener('click', () => openEditor(state.repos.find(repo => repo.name === button.dataset.name))));
    }
    async function readShowcases() {
      try {
        const file = await github(`/contents/${SHOWCASE_PATH}`);
        const parsed = JSON.parse(decodeUtf8(file.content));
        state.entries = Array.isArray(parsed.projects) ? parsed.projects : [];
        state.sha = file.sha;
      } catch (error) {
        if (!String(error.message).includes('(404)')) throw error;
        state.entries = []; state.sha = '';
      }
    }
    async function load() {
      state.token = getToken();
      if (!state.token) {
        $('#account-name').textContent = '请先登录编辑后台';
        $('#repository-status').innerHTML = '请先打开 <a href="/admin/">编辑后台</a>，使用 GitHub 登录后再返回此页。';
        return;
      }
      try {
        const user = await github('https://api.github.com/user');
        if (user.login !== OWNER) throw new Error('当前 GitHub 账户不是网站所有者。');
        $('#account-name').textContent = `GitHub / ${user.login}`;
        await Promise.all([readShowcases(), github('https://api.github.com/user/repos?affiliation=owner&per_page=100&sort=updated').then(repos => { state.repos = repos; })]);
        $('#repository-status').textContent = `共读取 ${state.repos.length} 个项目；保存后会自动触发网站更新。`;
        renderRepositories();
      } catch (error) { $('#repository-status').textContent = error.message || '无法读取项目。'; }
    }
    function countField(input, target) { $(target).textContent = input.value.length; }
    async function openEditor(repo) {
      if (!repo) return;
      state.active = repo; renderRepositories();
      const current = entryFor(repo.name) || { name: repo.name, status: 'off', summaryZh: '', summaryEn: '', demoUrl: '' };
      const fragment = $('#editor-template').content.cloneNode(true);
      const editor = $('#editor'); editor.innerHTML = ''; editor.append(fragment);
      $('[data-title]', editor).textContent = repo.name.replace(/-/g, ' ');
      $('[data-visibility]', editor).textContent = repo.private ? '私有仓库' : '公开仓库';
      $('[data-visibility]', editor).className = repo.private ? 'tag private' : 'tag public';
      $('[data-language]', editor).textContent = repo.language || '未标注语言';
      $('[data-updated]', editor).textContent = `更新于 ${formatDate(repo.updated_at)}`;
      const zh = $('[data-zh]', editor), en = $('[data-en]', editor), demo = $('[data-demo]', editor), published = $('[data-published]', editor);
      zh.value = current.summaryZh || ''; en.value = current.summaryEn || ''; demo.value = current.demoUrl || ''; published.checked = current.status === 'published';
      countField(zh, '[data-zh-count]'); countField(en, '[data-en-count]');
      zh.addEventListener('input', () => countField(zh, '[data-zh-count]')); en.addEventListener('input', () => countField(en, '[data-en-count]'));
      $('.close-editor', editor).addEventListener('click', () => { state.active = null; renderRepositories(); editor.innerHTML = '<div class="empty-editor"><span>练</span><h2>选择一个项目</h2><p>在左侧选择项目后，可以生成并编辑它在网站上的简介。</p></div>'; });
      $('[data-generate]', editor).addEventListener('click', () => generate(repo, editor));
      $('[data-save]', editor).addEventListener('click', () => save(repo, editor));
    }
    async function generate(repo, editor) {
      const button = $('[data-generate]', editor); const stateText = $('[data-readme-state]', editor);
      button.disabled = true; button.textContent = '正在读取并生成…'; stateText.textContent = '正在从 GitHub 安全读取 README…';
      try {
        const readme = await githubRaw(repo.name);
        const response = await fetch('/api/project-summary', { method: 'POST', headers: { 'content-type': 'application/json', Authorization: `Bearer ${state.token}` }, body: JSON.stringify({ repository: repo.name, readme }) });
        const result = await response.json(); if (!response.ok) throw new Error(result.error || '生成失败。');
        $('[data-zh]', editor).value = result.summaryZh; $('[data-en]', editor).value = result.summaryEn;
        countField($('[data-zh]', editor), '[data-zh-count]'); countField($('[data-en]', editor), '[data-en-count]');
        stateText.textContent = '草稿已生成，保存前可自行修改。';
      } catch (error) { stateText.textContent = error.message || '读取 README 或生成草稿失败。'; }
      finally { button.disabled = false; button.textContent = '✦ 从 README 生成草稿'; }
    }
    async function save(repo, editor) {
      const summaryZh = $('[data-zh]', editor).value.trim(); const summaryEn = $('[data-en]', editor).value.trim(); const demoUrl = $('[data-demo]', editor).value.trim(); const isPublished = $('[data-published]', editor).checked; const status = isPublished ? 'published' : (summaryZh || summaryEn ? 'draft' : 'off'); const message = $('[data-save-status]', editor);
      if (isPublished && (!summaryZh || !summaryEn)) { message.textContent = '请先填写中英文简介后再公开展示。'; return; }
      if (isPublished && repo.private && !confirm('确认公开这张项目介绍卡？私有仓库不会显示 GitHub 链接、README 或仓库元数据，但中英文简介和演示链接（如填写）会公开。')) return;
      const entry = { name: repo.name, visibility: repo.private ? 'private' : 'public', status, summaryZh, summaryEn, demoUrl, updatedAt: new Date().toISOString() };
      const projects = state.entries.filter(item => item.name !== repo.name); if (status !== 'off') projects.push(entry);
      const content = JSON.stringify({ projects }, null, 2) + '\n'; const button = $('[data-save]', editor); button.disabled = true; message.textContent = '正在保存到网站仓库…';
      try {
        const saved = await github(`/contents/${SHOWCASE_PATH}`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ message: `Manage showcase: ${repo.name}`, content: encodeUtf8(content), ...(state.sha ? { sha: state.sha } : {}) }) });
        state.entries = projects; state.sha = saved.content.sha; message.textContent = status === 'published' ? '已保存并加入发布队列。网站将在部署完成后更新。' : status === 'draft' ? '已保存为草稿，尚未公开。' : '已从网站展示清单移除。'; renderRepositories();
      } catch (error) { message.textContent = error.message || '保存失败。'; }
      finally { button.disabled = false; }
    }
    $('#search').addEventListener('input', event => { state.query = event.target.value; renderRepositories(); });
    $('#filters').addEventListener('click', event => { const button = event.target.closest('button[data-filter]'); if (!button) return; state.filter = button.dataset.filter; $('#filters').querySelectorAll('button').forEach(item => item.classList.toggle('active', item === button)); renderRepositories(); });
    $('#refresh').addEventListener('click', load);
    load();
  </script>
</BaseLayout>

<style>
  :global(body){background:#f5f3ee;color:#161614}.workspace{max-width:1580px;margin:auto;padding:28px 36px 42px}.topbar{display:grid;grid-template-columns:250px 1fr auto;align-items:center;gap:26px;padding:0 0 27px;border-bottom:1px solid #191918}.back,.github{font:13px var(--mono);color:#474641}.eyebrow{margin:0 0 7px;color:#b3251d;font:11px/1.1 var(--mono);letter-spacing:.12em}.topbar h1{margin:0;font:500 clamp(32px,4vw,52px)/.9 var(--serif);letter-spacing:-.06em}.account{display:flex;align-items:center;gap:8px;font:12px var(--mono);color:#51504b}.account span:first-child{width:8px;height:8px;border-radius:50%;background:#b3251d}.manager{display:grid;grid-template-columns:250px minmax(480px,1.25fr) minmax(360px,.75fr);min-height:calc(100vh - 160px);border:1px solid #d6d1c7;border-top:0;background:#fbfaf7}.rail,.repository-pane,.editor{padding:27px 22px}.rail{border-right:1px solid #d6d1c7;display:flex;flex-direction:column}.search{display:flex;align-items:center;gap:8px;border-bottom:1px solid #9a968d;padding:8px 0}.search span{font:23px var(--serif)}.search input{width:100%;border:0;outline:0;background:transparent;font:14px var(--sans)}.filters{display:grid;gap:2px;margin:27px 0}.filters button{display:flex;justify-content:space-between;padding:12px 10px;border:0;background:transparent;text-align:left;color:#282723;font:15px var(--serif);cursor:pointer}.filters button:hover,.filters button.active{background:#eae4d9}.filters button.active{border-left:2px solid #b3251d;padding-left:8px}.filters b{font:11px var(--mono);font-weight:400;color:#77736b}.privacy-note{margin-top:auto;padding:17px 0;border-top:1px solid #d6d1c7;color:#625e56;font:13px/1.7 var(--serif)}.privacy-note strong{display:block;color:#b3251d;font-weight:500}.github{margin-top:20px}.repository-pane{border-right:1px solid #d6d1c7}.pane-head,.editor-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}.pane-head h2,.editor h2{margin:0;font:500 27px var(--serif);letter-spacing:-.04em}.text-button,.outline,.close-editor{border:0;background:none;cursor:pointer;font:12px var(--mono);color:#b3251d}.status{min-height:44px;color:#6c6962;font:13px/1.5 var(--serif)}.repository-list{border-top:1px solid #222}.repo-row{width:100%;display:grid;grid-template-columns:42px minmax(0,1fr) auto 105px 16px;gap:12px;align-items:center;padding:18px 6px;border:0;border-bottom:1px solid #ddd8ce;background:transparent;text-align:left;cursor:pointer}.repo-row:hover,.repo-row.selected{background:#f0ece3}.repo-index{font:12px var(--mono);color:#b3251d}.repo-main{min-width:0}.repo-main strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:500 17px var(--serif);text-transform:none}.repo-main small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:5px;color:#777169;font:12px var(--sans)}.badges{display:grid;gap:4px}.badges i,.tag{font:10px var(--mono);font-style:normal}.badges .private,.tag.private{color:#8a560c}.badges .public,.tag.public{color:#3d6256}.state-published{color:#b3251d}.state-draft{color:#81690e}.state-off{color:#8c8880}.repo-date{color:#858078;font:10px/1.4 var(--mono)}.arrow{color:#b3251d}.no-results{padding:25px 0;color:#6c6962;font:14px var(--serif)}.editor{background:#f8f6f1}.empty-editor{height:100%;display:grid;place-content:center;text-align:center;color:#777169}.empty-editor span{font:90px var(--serif);color:#cfc7ba}.empty-editor h2{margin:10px 0}.empty-editor p{max-width:240px;margin:auto;font:14px/1.6 var(--serif)}.close-editor{font-size:28px;line-height:1;color:#222}.repo-tags{display:flex;flex-wrap:wrap;gap:11px;margin:17px 0 23px;color:#777169;font:11px var(--mono)}.readme-card{display:flex;justify-content:space-between;gap:20px;padding:17px;border:1px solid #d7d1c5;background:#fffdfa}.readme-card p:not(.eyebrow){margin:0;max-width:190px;color:#6c6962;font:13px/1.5 var(--serif)}.outline{border:1px solid #b3251d;padding:9px 10px;align-self:center;white-space:nowrap}.outline:disabled,.save:disabled{opacity:.55;cursor:wait}.ai-note{margin:10px 0 20px;color:#777169;font:11px/1.5 var(--sans)}.editor label{display:block;margin-top:17px;color:#3f3d38;font:13px var(--serif)}.editor input:not([type=checkbox]),.editor textarea{box-sizing:border-box;width:100%;margin-top:7px;border:1px solid #cfc9be;border-radius:0;background:#fffdfa;padding:10px;font:13px/1.5 var(--sans);outline-color:#b3251d}.editor textarea{min-height:72px;resize:vertical}.editor label small{display:block;margin-top:3px;text-align:right;color:#8c8880;font:10px var(--mono)}.public-toggle{display:flex!important;gap:10px;padding:15px 0;border-top:1px solid #d6d1c7;border-bottom:1px solid #d6d1c7}.public-toggle input{accent-color:#b3251d;margin-top:3px}.public-toggle strong,.public-toggle em{display:block}.public-toggle strong{font-weight:500}.public-toggle em{margin-top:4px;color:#777169;font:11px/1.5 var(--sans);font-style:normal}.save{display:flex;justify-content:space-between;align-items:center;width:100%;margin-top:20px;padding:14px 15px;border:0;background:#b3251d;color:#fff;font:13px var(--mono);cursor:pointer}.save span{font-size:20px}.save-status{min-height:30px;margin:10px 0;color:#6c6962;font:12px/1.55 var(--serif)}@media(max-width:1050px){.manager{grid-template-columns:210px 1fr}.editor{grid-column:1/-1;border-top:1px solid #d6d1c7}.rail{border-right:1px solid #d6d1c7}.repository-pane{border-right:0}}@media(max-width:660px){.workspace{padding:18px 14px}.topbar{grid-template-columns:1fr;gap:15px}.manager{display:block}.rail,.repository-pane{border-right:0;border-bottom:1px solid #d6d1c7}.rail{min-height:auto}.privacy-note{margin-top:20px}.repo-row{grid-template-columns:32px 1fr auto 15px}.repo-date{display:none}.repo-main strong{font-size:16px}.readme-card{display:block}.outline{margin-top:13px}.account{position:absolute;top:18px;right:16px}}
</style>
