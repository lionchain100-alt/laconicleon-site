---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = [
  { zh:'PNG Binder', en:'PNG Binder', zhDesc:'在浏览器中按顺序合并 PNG、JPG 与 JPEG 文件，生成一个 PDF。', enDesc:'Combine PNG, JPG, and JPEG files into one ordered PDF directly in the browser.', status:'完成', enStatus:'Complete', year:'2026', href:'https://pngbinder.com' },
  { zh:'Image to Text', en:'Image to Text', zhDesc:'将图像中的文字转换成可编辑文本的轻量工具。', enDesc:'A lightweight tool for turning text in images into editable text.', status:'进行中', enStatus:'In progress', year:'2026', href:'https://github.com/lionchain100-alt/image-to-text' },
  { zh:'Handwriting to Notion', en:'Handwriting to Notion', zhDesc:'把手写内容整理为可进入 Notion 的结构化笔记。', enDesc:'Turn handwriting into structured notes ready for Notion.', status:'进行中', enStatus:'In progress', year:'2026', href:'https://github.com/lionchain100-alt/handwriting-to-notion' }
];
---
<BaseLayout title="项目 — laconicleon" description="Leon Reed / 简练的项目与工具。"><main><header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><nav><a href="/writing"><span class="zh">文章</span><span class="en" hidden>Writing</span></a><a class="active" href="/projects"><span class="zh">项目</span><span class="en" hidden>Projects</span></a><a href="/about"><span class="zh">关于</span><span class="en" hidden>About</span></a></nav><button id="lang">中 <i>/</i> EN</button></header><section class="intro"><h1 class="zh">项目</h1><h1 class="en" hidden>Projects</h1><p class="zh">一些有用的工具与实验，关注实际、效率与思考方式。</p><p class="en" hidden>Useful tools and experiments, shaped around clarity, utility, and thoughtful work.</p></section><section class="featured"><div><p class="label"><span class="zh">精选项目</span><span class="en" hidden>Featured project</span></p><h2>PNG Binder</h2><p class="zh">一件安静完成工作的浏览器工具：不需要账号，不添加水印。</p><p class="en" hidden>A quiet browser tool that does one job well—without accounts or watermarks.</p><dl><div><dt><span class="zh">状态</span><span class="en" hidden>Status</span></dt><dd><span class="zh">已完成</span><span class="en" hidden>Complete</span></dd></div><div><dt><span class="zh">年份</span><span class="en" hidden>Year</span></dt><dd>2026</dd></div></dl><a href="https://pngbinder.com" target="_blank" rel="noreferrer"><span class="zh">查看项目</span><span class="en" hidden>View project</span> <b>→</b></a></div><figure><span>PNG<br/>→<br/>PDF</span></figure></section><section class="list">{projects.slice(1).map((project, index) => <a href={project.href} target="_blank" rel="noreferrer"><b>0{index+2}</b><h2><span class="zh">{project.zh}</span><span class="en" hidden>{project.en}</span></h2><p class="zh">{project.zhDesc}</p><p class="en" hidden>{project.enDesc}</p><small><span class="zh">{project.status}</span><span class="en" hidden>{project.enStatus}</span> · {project.year}</small><i>→</i></a>)}</section></main><script>let l: 'zh'|'en'=localStorage.getItem('laconicleon-language')==='en'?'en':'zh';const r=()=>{document.documentElement.lang=l==='en'?'en':'zh-CN';document.querySelectorAll<HTMLElement>('.zh,.en').forEach(n=>n.toggleAttribute('hidden',l==='en'?n.classList.contains('zh'):n.classList.contains('en')));localStorage.setItem('laconicleon-language',l)};document.querySelector('#lang')?.addEventListener('click',()=>{l=l==='en'?'zh':'en';r()});r();</script></BaseLayout>
<style>[hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}header{height:105px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:16px;font:500 31px var(--display)}.brand img{width:38px;height:55px;object-fit:contain}nav{display:flex;gap:43px;margin-left:auto;font:16px var(--serif)}nav a{padding:11px 0;border-bottom:2px solid transparent}.active{color:var(--accent);border-color:var(--accent)}button{margin-left:42px;border:0;background:none;cursor:pointer;font:14px var(--mono)}button i{color:var(--accent);font-style:normal}.intro{padding:68px 4% 48px;border-bottom:1px solid var(--ink)}.intro h1{font:500 clamp(60px,8vw,107px)/1 var(--serif);letter-spacing:-.08em;margin:0}.intro p{max-width:350px;margin:23px 0 0;font:18px/1.7 var(--serif);color:var(--muted)}.featured{display:grid;grid-template-columns:34% 1fr;gap:6%;padding:54px 4%;border-bottom:1px solid var(--accent)}.label{font:13px var(--mono);color:var(--accent)}.featured h2{font:500 47px var(--serif);margin:35px 0 14px}.featured p{font:18px/1.7 var(--serif)}dl{margin:33px 0 25px;border-top:1px solid var(--ink)}dl div{display:grid;grid-template-columns:1fr 1fr;padding:10px 0;border-bottom:1px solid var(--line);font:14px var(--serif)}dd{margin:0;color:var(--accent)}.featured a{color:var(--accent);border-bottom:1px solid var(--accent);padding-bottom:6px}.featured figure{min-height:337px;margin:0;border:1px solid var(--ink);display:grid;place-items:center;background:linear-gradient(135deg,#fff 0%,#fafafa 100%)}figure span{font:500 clamp(44px,7vw,96px)/.88 var(--display);text-align:center;letter-spacing:-.08em}.list a{position:relative;display:grid;grid-template-columns:90px 240px minmax(0,1fr) 120px 30px;gap:25px;align-items:center;padding:32px 4%;border-bottom:1px solid var(--accent)}.list>a>b{font:29px var(--mono);color:var(--accent);font-weight:400}.list h2{font:500 31px var(--serif);margin:0}.list p{font:16px/1.55 var(--serif);margin:0;color:var(--muted)}.list small{font:13px var(--mono);color:var(--accent)}.list i{font:27px var(--sans);font-style:normal}@media(max-width:760px){main{padding:0 20px}header{height:75px}.brand{font-size:25px}.brand img{width:29px;height:43px}nav{display:none}button{margin-left:auto}.intro{padding:50px 0 34px}.intro h1{font-size:68px}.featured{display:block;padding:36px 0}.featured h2{margin-top:25px}.featured figure{margin-top:35px;min-height:230px}.list a{grid-template-columns:48px 1fr 20px;gap:12px;padding:25px 0}.list h2{font-size:25px}.list p,.list small{grid-column:2}.list i{grid-column:3;grid-row:1;align-self:center}}</style>
