---
import BaseLayout from '../layouts/BaseLayout.astro';
import showcaseData from '../data/project-showcases.json';

interface Showcase { name: string; visibility: 'public' | 'private'; status: 'draft' | 'published'; summaryZh: string; summaryEn: string; demoUrl?: string; updatedAt?: string; }
const projects = (showcaseData.projects as Showcase[]).filter((project) => project.status === 'published');
const displayName = (name: string) => name.split('-').map((part) => part[0]?.toUpperCase() + part.slice(1)).join(' ');
---
<BaseLayout title="项目 — laconicleon" description="Leon Reed / 简练的独立项目与工具。"><main><header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><nav><a href="/writing"><span class="zh">文章</span><span class="en" hidden>Writing</span></a><a class="active" href="/projects"><span class="zh">项目</span><span class="en" hidden>Projects</span></a><a href="/about"><span class="zh">关于</span><span class="en" hidden>About</span></a><a href="/now"><span class="zh">此刻</span><span class="en" hidden>Now</span></a></nav><button id="lang">中 <i>/</i> EN</button></header><section class="intro"><p class="kicker">SELECTED WORK</p><h1 class="zh">项目</h1><h1 class="en" hidden>Projects</h1><p class="zh">一些持续打磨的小工具、产品实验与独立项目。</p><p class="en" hidden>A selected collection of tools, product experiments, and independent work.</p></section>{projects.length ? <section class="list">{projects.map((project, index) => <article><b>{String(index + 1).padStart(2, '0')}</b><div><p class="type"><span class="zh">{project.visibility === 'private' ? '独立项目' : '开源项目'}</span><span class="en" hidden>{project.visibility === 'private' ? 'Independent project' : 'Open-source project'}</span></p><h2>{displayName(project.name)}</h2><p class="summary zh">{project.summaryZh}</p><p class="summary en" hidden>{project.summaryEn}</p><p class="context zh">以公开项目简介展示，不公开私有仓库或源代码。</p><p class="context en" hidden>Presented as a public project profile; its private repository and source remain private.</p></div><aside><p><span class="zh">项目档案</span><span class="en" hidden>Project record</span></p><dl><div><dt><span class="zh">形式</span><span class="en" hidden>Format</span></dt><dd>Web product</dd></div><div><dt><span class="zh">可见性</span><span class="en" hidden>Visibility</span></dt><dd><span class="zh">{project.visibility === 'private' ? '私有开发' : '公开'}</span><span class="en" hidden>{project.visibility === 'private' ? 'Private build' : 'Public'}</span></dd></div></dl><em aria-hidden="true">{displayName(project.name).split(' ').map((word) => word[0]).join('')}</em></aside>{project.demoUrl ? <a class="visit" href={project.demoUrl} target="_blank" rel="noreferrer"><span class="zh">访问项目</span><span class="en" hidden>Visit project</span> ↗</a> : <span class="mark">—</span>}</article>)}</section> : <p class="empty"><span class="zh">项目正在整理中。</span><span class="en" hidden>Selected work is being prepared.</span></p>}</main><script>let l: 'zh'|'en'=localStorage.getItem('laconicleon-language')==='en'?'en':'zh';const r=()=>{document.documentElement.lang=l==='en'?'en':'zh-CN';document.querySelectorAll<HTMLElement>('.zh,.en').forEach(n=>n.toggleAttribute('hidden',l==='en'?n.classList.contains('zh'):n.classList.contains('en')));localStorage.setItem('laconicleon-language',l)};document.querySelector('#lang')?.addEventListener('click',()=>{l=l==='en'?'zh':'en';r()});r();</script></BaseLayout>
<style>[hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}header{height:105px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:16px;font:500 31px var(--display)}.brand img{width:38px;height:55px;object-fit:contain}nav{display:flex;gap:43px;margin-left:auto;font:16px var(--serif)}nav a{padding:11px 0;border-bottom:2px solid transparent}.active{color:var(--accent);border-color:var(--accent)}button{margin-left:42px;border:0;background:none;cursor:pointer;font:14px var(--mono)}button i{color:var(--accent);font-style:normal}.intro{padding:68px 4% 48px;border-bottom:1px solid var(--ink)}.kicker{margin:0 0 18px;color:var(--accent);font:11px var(--mono);letter-spacing:.14em}.intro h1{font:500 clamp(60px,8vw,107px)/1 var(--serif);letter-spacing:-.08em;margin:0}.intro p:not(.kicker){max-width:510px;margin:23px 0 0;font:18px/1.7 var(--serif);color:var(--muted)}.list{padding:0 4% 85px}.list article{display:grid;grid-template-columns:90px minmax(280px,1.15fr) minmax(220px,.7fr) auto;gap:36px;align-items:start;padding:58px 0;border-bottom:1px solid var(--ink)}.list>b{font:29px var(--mono);color:var(--accent);font-weight:400}.type{margin:0 0 10px;color:var(--accent);font:11px var(--mono);letter-spacing:.08em}.list h2{font:500 clamp(38px,4vw,59px)/1.06 var(--serif);letter-spacing:-.055em;margin:0;text-transform:none}.summary{font:23px/1.45 var(--serif)!important;margin:20px 0 0!important;color:var(--ink)!important}.context{max-width:440px;font:16px/1.7 var(--serif)!important;margin:16px 0 0!important;color:var(--muted)!important}.list aside{position:relative;min-height:190px;padding:19px 21px;border:1px solid var(--ink);overflow:hidden}.list aside>p{margin:0 0 16px;color:var(--accent);font:11px var(--mono);letter-spacing:.08em}.list dl{margin:0}.list dl div{display:flex;justify-content:space-between;gap:15px;padding:8px 0;border-top:1px solid var(--line);font:13px var(--serif)}.list dt{color:var(--muted)}.list dd{margin:0;text-align:right}.list em{position:absolute;right:-3px;bottom:-26px;color:#f0f0ed;font:500 104px/.8 var(--display);font-style:normal;letter-spacing:-.1em}.visit{align-self:center;padding:10px 0;border-bottom:1px solid var(--accent);color:var(--accent);font:12px var(--mono);white-space:nowrap}.mark{color:var(--accent);font:24px var(--serif)}.empty{margin:70px 4%;font:19px var(--serif);color:var(--muted)}@media(max-width:760px){main{padding:0 20px}header{height:75px}.brand{font-size:25px}.brand img{width:29px;height:43px}nav{display:none}button{margin-left:auto}.intro{padding:50px 0 34px}.intro h1{font-size:68px}.list{padding:0 0 56px}.list article{grid-template-columns:42px 1fr;gap:13px;padding:38px 0}.list h2{font-size:36px}.list aside{grid-column:2;min-height:170px}.summary{font-size:21px!important}.context{font-size:15px!important}.visit,.mark{grid-column:2;justify-self:start}}</style>
