---
import BaseLayout from '../layouts/BaseLayout.astro';
import showcaseData from '../data/project-showcases.json';

interface Showcase { name: string; visibility: 'public' | 'private'; status: 'draft' | 'published'; summaryZh: string; summaryEn: string; demoUrl?: string; updatedAt?: string; }
const projects = (showcaseData.projects as Showcase[]).filter((project) => project.status === 'published');
const displayName = (name: string) => name.split('-').map((part) => part[0]?.toUpperCase() + part.slice(1)).join(' ');
---
<BaseLayout title="项目 — laconicleon" description="Leon Reed / 简练的独立项目与工具。"><main><header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><nav><a href="/writing"><span class="zh">文章</span><span class="en" hidden>Writing</span></a><a class="active" href="/projects"><span class="zh">项目</span><span class="en" hidden>Projects</span></a><a href="/about"><span class="zh">关于</span><span class="en" hidden>About</span></a></nav><button id="lang">中 <i>/</i> EN</button></header><section class="intro"><p class="kicker">SELECTED WORK</p><h1 class="zh">项目</h1><h1 class="en" hidden>Projects</h1><p class="zh">一些持续打磨的小工具、产品实验与独立项目。</p><p class="en" hidden>A selected collection of tools, product experiments, and independent work.</p></section>{projects.length ? <section class="list">{projects.map((project, index) => <article><b>{String(index + 1).padStart(2, '0')}</b><div><p class="type"><span class="zh">{project.visibility === 'private' ? '独立项目' : '开源项目'}</span><span class="en" hidden>{project.visibility === 'private' ? 'Independent project' : 'Open-source project'}</span></p><h2>{displayName(project.name)}</h2><p class="zh">{project.summaryZh}</p><p class="en" hidden>{project.summaryEn}</p></div>{project.demoUrl ? <a class="visit" href={project.demoUrl} target="_blank" rel="noreferrer"><span class="zh">访问项目</span><span class="en" hidden>Visit project</span> ↗</a> : <span class="mark">—</span>}</article>)}</section> : <p class="empty"><span class="zh">项目正在整理中。</span><span class="en" hidden>Selected work is being prepared.</span></p>}</main><script>let l: 'zh'|'en'=localStorage.getItem('laconicleon-language')==='en'?'en':'zh';const r=()=>{document.documentElement.lang=l==='en'?'en':'zh-CN';document.querySelectorAll<HTMLElement>('.zh,.en').forEach(n=>n.toggleAttribute('hidden',l==='en'?n.classList.contains('zh'):n.classList.contains('en')));localStorage.setItem('laconicleon-language',l)};document.querySelector('#lang')?.addEventListener('click',()=>{l=l==='en'?'zh':'en';r()});r();</script></BaseLayout>
<style>[hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}header{height:105px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:16px;font:500 31px var(--display)}.brand img{width:38px;height:55px;object-fit:contain}nav{display:flex;gap:43px;margin-left:auto;font:16px var(--serif)}nav a{padding:11px 0;border-bottom:2px solid transparent}.active{color:var(--accent);border-color:var(--accent)}button{margin-left:42px;border:0;background:none;cursor:pointer;font:14px var(--mono)}button i{color:var(--accent);font-style:normal}.intro{padding:68px 4% 48px;border-bottom:1px solid var(--ink)}.kicker{margin:0 0 18px;color:var(--accent);font:11px var(--mono);letter-spacing:.14em}.intro h1{font:500 clamp(60px,8vw,107px)/1 var(--serif);letter-spacing:-.08em;margin:0}.intro p:not(.kicker){max-width:510px;margin:23px 0 0;font:18px/1.7 var(--serif);color:var(--muted)}.list{padding:20px 4% 85px}.list article{display:grid;grid-template-columns:90px minmax(200px,1fr) auto;gap:30px;align-items:center;padding:34px 0;border-bottom:1px solid var(--accent)}.list>b{font:29px var(--mono);color:var(--accent);font-weight:400}.type{margin:0 0 8px;color:var(--accent);font:11px var(--mono);letter-spacing:.08em}.list h2{font:500 31px var(--serif);margin:0;text-transform:none}.list div>p:last-child{font:16px/1.55 var(--serif);margin:7px 0 0;color:var(--muted)}.visit{padding:10px 0;border-bottom:1px solid var(--accent);color:var(--accent);font:12px var(--mono);white-space:nowrap}.mark{color:var(--accent);font:24px var(--serif)}.empty{margin:70px 4%;font:19px var(--serif);color:var(--muted)}@media(max-width:760px){main{padding:0 20px}header{height:75px}.brand{font-size:25px}.brand img{width:29px;height:43px}nav{display:none}button{margin-left:auto}.intro{padding:50px 0 34px}.intro h1{font-size:68px}.list{padding:0 0 56px}.list article{grid-template-columns:48px 1fr;gap:12px;padding:26px 0}.list h2{font-size:24px}.visit,.mark{grid-column:2;justify-self:start}}</style>
