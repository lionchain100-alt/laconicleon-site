---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import showcaseData from '../data/project-showcases.json';

interface Showcase {
  name: string;
  visibility: 'public' | 'private';
  status: 'draft' | 'published';
  summaryZh: string;
  summaryEn: string;
  contextZh: string;
  contextEn: string;
  demoUrl?: string;
  image?: string;
}

const projects = (showcaseData.projects as Showcase[]).filter((project) => project.status === 'published');
const displayName = (name: string) => name.split('-').map((part) => part[0]?.toUpperCase() + part.slice(1)).join(' ');
---

<BaseLayout title="项目 — laconicleon" description="Leon Reed / 简练的独立项目与工具。">
  <main>
    <SiteHeader active="projects" />

    <section class="intro">
      <p class="kicker">SELECTED WORK</p>
      <h1><span class="zh">项目</span><span class="en" hidden>Projects</span></h1>
      <p class="zh">一些持续打磨的小工具、产品实验与独立项目。</p>
      <p class="en" hidden>A selected collection of tools, product experiments, and independent work.</p>
    </section>
    <figure class="project-map"><img src="/ink-projects-map.png" alt="水墨山水与远亭" loading="eager"/><figcaption><span class="zh">山水有意，留白无声</span><span class="en" hidden>Still water, open space</span></figcaption></figure>

    {projects.length ? <section class="list">
      {projects.map((project, index) => <article class:list={{ reverse: index % 2 === 1 }}>
        <b>{String(index + 1).padStart(2, '0')}</b>
        <div class="copy">
          <p class="type"><span class="zh">{project.visibility === 'private' ? '独立项目' : '开源项目'}</span><span class="en" hidden>{project.visibility === 'private' ? 'Independent project' : 'Open-source project'}</span></p>
          <h2>{displayName(project.name)}</h2>
          <p class="summary zh">{project.summaryZh}</p><p class="summary en" hidden>{project.summaryEn}</p>
          <p class="context zh">{project.contextZh}</p>
          <p class="context en" hidden>{project.contextEn}</p>
          {project.demoUrl && <a class="visit" href={project.demoUrl} target="_blank" rel="noreferrer"><span class="zh">访问项目</span><span class="en" hidden>Visit project</span> <b>↗</b></a>}
        </div>
        <figure class="project-shot">
          {project.image ? <img src={project.image} alt={`${displayName(project.name)} preview`} loading="lazy" /> : <div class="pending"><span>WORK IN PROGRESS</span></div>}
          <figcaption><span class="zh">公开产品画面</span><span class="en" hidden>Public product view</span></figcaption>
        </figure>
      </article>)}
    </section> : <p class="empty"><span class="zh">项目正在整理中。</span><span class="en" hidden>Selected work is being prepared.</span></p>}
    <SiteFooter class="project-footer"><span class="zh">持续整理正在打磨的产品与工具。</span><span class="en" hidden>An evolving record of products and tools in progress.</span></SiteFooter>
  </main>
</BaseLayout>

<style>
  [hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}.intro{padding:68px 4% 48px;border-bottom:1px solid var(--ink)}.kicker{margin:0 0 18px;color:var(--accent);font:11px var(--mono);letter-spacing:.14em}.intro h1{font:500 clamp(60px,8vw,107px)/1 var(--serif);letter-spacing:-.08em;margin:0}.intro p:not(.kicker){max-width:510px;margin:23px 0 0;font:18px/1.7 var(--serif);color:var(--muted)}.project-map{position:relative;height:250px;margin:0 4%;overflow:hidden;border-bottom:1px solid var(--ink)}.project-map img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 48%;filter:contrast(1.05) saturate(.78)}.project-map figcaption{position:absolute;right:16px;bottom:13px;color:var(--accent);font:10px var(--mono);letter-spacing:.1em}.list{padding:0 4% 85px}.list article{display:grid;grid-template-columns:74px minmax(0,.82fr) minmax(360px,1.18fr);gap:38px;padding:64px 0;border-bottom:1px solid var(--ink)}.list article.reverse .copy{grid-column:3}.list article.reverse .project-shot{grid-column:2;grid-row:1}.list article>b{font:29px var(--mono);color:var(--accent);font-weight:400}.type{margin:0 0 10px;color:var(--accent);font:11px var(--mono);letter-spacing:.08em}.copy h2{font:500 clamp(38px,4.2vw,61px)/1.06 var(--serif);letter-spacing:-.055em;margin:0;overflow-wrap:anywhere}.summary{font:23px/1.45 var(--serif);margin:20px 0 0}.context{max-width:420px;font:16px/1.7 var(--serif);margin:16px 0 27px;color:var(--muted)}.visit{display:inline-block;padding:8px 0;border-bottom:1px solid var(--accent);color:var(--accent);font:12px var(--mono);white-space:nowrap}.visit b{font:20px var(--sans);font-weight:400}.project-shot{position:relative;margin:0;border:1px solid var(--ink);background:#f4f3ef;align-self:start}.project-shot img{display:block;width:100%;aspect-ratio:1.48;object-fit:cover;object-position:center top;filter:saturate(.86) contrast(1.02)}.project-shot figcaption{display:flex;justify-content:space-between;padding:10px 14px;border-top:1px solid var(--ink);color:var(--accent);font:10px var(--mono);letter-spacing:.1em}.pending{aspect-ratio:1.48;display:grid;place-items:center;font:12px var(--mono);color:var(--muted);letter-spacing:.12em}.empty{margin:70px 4%;font:19px var(--serif);color:var(--muted)}.project-footer{padding:20px 4% 38px;color:var(--muted);font:12px var(--mono)}@media(max-width:760px){main{padding:0 20px}.intro{padding:50px 0 34px}.intro h1{font-size:clamp(56px,18vw,68px)}.project-map{height:148px;margin:0}.project-map figcaption{right:9px;bottom:9px;font-size:9px}.list{padding:0 0 56px}.list article,.list article.reverse{grid-template-columns:42px minmax(0,1fr);gap:13px;padding:38px 0}.list article.reverse .copy,.list article.reverse .project-shot{grid-column:2;grid-row:auto}.copy h2{font-size:36px}.summary{font-size:21px}.context{font-size:15px}.project-shot{grid-column:2;margin-top:17px}.project-footer{padding:20px 0 38px}}
</style>
