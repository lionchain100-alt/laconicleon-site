---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../data/project-settings.json';

interface GitHubProject { name: string; description: string | null; html_url: string; updated_at: string; stargazers_count: number; primary_language: string | null; }
const selectedProjects = settings.selectedProjects ?? [];
const fetched = await Promise.all(selectedProjects.map(async (name) => {
  try {
    const response = await fetch(`https://api.github.com/repos/lionchain100-alt/${encodeURIComponent(name)}`, { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'laconicleon-site' } });
    return response.ok ? await response.json() as GitHubProject : null;
  } catch { return null; }
}));
const projects = fetched.filter((project): project is GitHubProject => project !== null);
const displayName = (name: string) => name.split('-').map((part) => part[0]?.toUpperCase() + part.slice(1)).join(' ');
const summaries: Record<string, { zh: string; en: string }> = {
  'image-to-text': { zh: '将图像中的文字转换为可编辑文本的轻量工具。', en: 'A lightweight image-to-text utility.' },
  'handwriting-to-notion': { zh: '把手写内容整理为可进入 Notion 的结构化笔记。', en: 'A workflow for turning handwriting into structured notes.' },
  'biolink-pro': { zh: '面向创作者的个人链接页工具。', en: 'A Linktree alternative for creators.' },
  'note-ocr-backend': { zh: '为笔记识别提供支撑的后端服务。', en: 'Backend services for note recognition.' },
  'codex-orange-book': { zh: '从安装到实战案例的 Codex 使用指南。', en: 'A practical, end-to-end guide to using Codex.' },
  'laconicleon-site': { zh: 'Leon Reed / 简练的个人写作网站。', en: 'The personal writing site for Leon Reed / 简练.' }
};
---
<BaseLayout title="项目 — laconicleon" description="Leon Reed / 简练的 GitHub 项目与工具。"><main><header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><nav><a href="/writing"><span class="zh">文章</span><span class="en" hidden>Writing</span></a><a class="active" href="/projects"><span class="zh">项目</span><span class="en" hidden>Projects</span></a><a href="/about"><span class="zh">关于</span><span class="en" hidden>About</span></a></nav><button id="lang">中 <i>/</i> EN</button></header><section class="intro"><h1 class="zh">项目</h1><h1 class="en" hidden>Projects</h1><p class="zh">从 GitHub 自动同步的公开项目。展示范围由我在后台决定。</p><p class="en" hidden>Public projects synced from GitHub, selected from the site admin.</p></section>{projects.length ? <section class="list">{projects.map((project, index) => <a href={project.html_url} target="_blank" rel="noreferrer"><b>{String(index + 1).padStart(2, '0')}</b><div><h2>{displayName(project.name)}</h2><p class="zh">{summaries[project.name]?.zh || `GitHub 公开项目：${displayName(project.name)}。`}</p><p class="en" hidden>{summaries[project.name]?.en || project.description || 'An independent GitHub project.'}</p></div><small><span class="zh">更新于</span><span class="en" hidden>Updated</span> {new Date(project.updated_at).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit' }).replaceAll('/', '.')}<br/>{project.primary_language || '—'} · ★ {project.stargazers_count}</small><i>↗</i></a>)}</section> : <p class="empty"><span class="zh">还没有选择需要同步的项目。请在后台的「网站设置」中勾选。</span><span class="en" hidden>No projects selected yet. Choose them in Site settings.</span></p>}</main><script>let l: 'zh'|'en'=localStorage.getItem('laconicleon-language')==='en'?'en':'zh';const r=()=>{document.documentElement.lang=l==='en'?'en':'zh-CN';document.querySelectorAll<HTMLElement>('.zh,.en').forEach(n=>n.toggleAttribute('hidden',l==='en'?n.classList.contains('zh'):n.classList.contains('en')));localStorage.setItem('laconicleon-language',l)};document.querySelector('#lang')?.addEventListener('click',()=>{l=l==='en'?'zh':'en';r()});r();</script></BaseLayout>
<style>[hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}header{height:105px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:16px;font:500 31px var(--display)}.brand img{width:38px;height:55px;object-fit:contain}nav{display:flex;gap:43px;margin-left:auto;font:16px var(--serif)}nav a{padding:11px 0;border-bottom:2px solid transparent}.active{color:var(--accent);border-color:var(--accent)}button{margin-left:42px;border:0;background:none;cursor:pointer;font:14px var(--mono)}button i{color:var(--accent);font-style:normal}.intro{padding:68px 4% 48px;border-bottom:1px solid var(--ink)}.intro h1{font:500 clamp(60px,8vw,107px)/1 var(--serif);letter-spacing:-.08em;margin:0}.intro p{max-width:480px;margin:23px 0 0;font:18px/1.7 var(--serif);color:var(--muted)}.list{padding:20px 4% 85px}.list a{display:grid;grid-template-columns:90px minmax(200px,1fr) 160px 30px;gap:30px;align-items:center;padding:34px 0;border-bottom:1px solid var(--accent)}.list>a>b{font:29px var(--mono);color:var(--accent);font-weight:400}.list h2{font:500 31px var(--serif);margin:0}.list p{font:16px/1.55 var(--serif);margin:7px 0 0;color:var(--muted)}.list small{font:12px/1.65 var(--mono);color:var(--muted)}.list i{font:25px var(--sans);font-style:normal;color:var(--accent)}.empty{margin:70px 4%;font:19px var(--serif);color:var(--muted)}@media(max-width:760px){main{padding:0 20px}header{height:75px}.brand{font-size:25px}.brand img{width:29px;height:43px}nav{display:none}button{margin-left:auto}.intro{padding:50px 0 34px}.intro h1{font-size:68px}.list{padding:0 0 56px}.list a{grid-template-columns:48px 1fr 20px;gap:12px;padding:26px 0}.list h2{font-size:24px}.list p,.list small{grid-column:2}.list i{grid-column:3;grid-row:1;align-self:center}}</style>
