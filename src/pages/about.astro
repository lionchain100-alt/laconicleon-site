---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="关于 — laconicleon" description="Leon Reed / 简练的个人介绍。">
  <main><header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><nav><a href="/writing"><span class="zh">文章</span><span class="en" hidden>Writing</span></a><a href="/projects"><span class="zh">项目</span><span class="en" hidden>Projects</span></a><a class="active" href="/about"><span class="zh">关于</span><span class="en" hidden>About</span></a><a href="/now"><span class="zh">此刻</span><span class="en" hidden>Now</span></a></nav><button id="lang">中 <i>/</i> EN</button></header>
    <section class="hero"><div><p class="zh">关于我</p><p class="en" hidden>About</p><h1 class="zh">我偏爱简练、克制、<br/>真诚的表达。</h1><h1 class="en" hidden>I value clarity, restraint,<br/>and honest expression.</h1><span class="zh">文字与视觉，是我理解世界、也与世界沟通的方式。</span><span class="en" hidden>Words and visuals are how I make sense of the world—and speak back to it.</span></div><figure><img src="/ink-lion-hero.png" alt="水墨狮子"/></figure></section>
    <section class="details"><div><p class="label"><span class="zh">关于</span><span class="en" hidden>About</span></p><p class="zh">我是 Leon Reed，也使用「简练」这个名字。这里是我长期写作、整理想法和展示作品的地方。比起追逐快速更新，我更在意把有价值的事做得清楚、耐用，并且能经得起回看。</p><p class="en" hidden>I am Leon Reed, also writing as 简练. This is where I write, organize ideas, and share what I make. I care less about fast updates than work that is clear, durable, and worth returning to.</p></div><div><p class="label"><span class="zh">关注</span><span class="en" hidden>Focus</span></p><ul class="zh"><li>写作与思考</li><li>个人知识系统</li><li>产品与交互设计</li><li>独立工具与长期创作</li></ul><ul class="en" hidden><li>Writing and thinking</li><li>Personal knowledge systems</li><li>Product and interaction design</li><li>Independent tools and long-term work</li></ul></div></section>
    <section class="values"><p class="label"><span class="zh">创作观</span><span class="en" hidden>Principles</span></p><ol><li><b>01</b><span class="zh">简练：去掉多余，直达本质。</span><span class="en" hidden>Clarity: remove excess and get to the point.</span></li><li><b>02</b><span class="zh">克制：让信息与留白各得其所。</span><span class="en" hidden>Restraint: give information and space their due.</span></li><li><b>03</b><span class="zh">诚实：不把过程伪装成结论。</span><span class="en" hidden>Honesty: do not disguise process as conclusion.</span></li><li><b>04</b><span class="zh">持续：把值得的事慢慢做深。</span><span class="en" hidden>Continuity: stay with worthwhile work.</span></li></ol></section>
    <footer><p class="label"><span class="zh">联系</span><span class="en" hidden>Contact</span></p><a href="https://github.com/lionchain100-alt" target="_blank" rel="noreferrer">GitHub <b>↗</b></a><a href="/rss.xml">RSS <b>↗</b></a></footer>
  </main><script>let l: 'zh'|'en'=localStorage.getItem('laconicleon-language')==='en'?'en':'zh';const r=()=>{document.documentElement.lang=l==='en'?'en':'zh-CN';document.querySelectorAll<HTMLElement>('.zh,.en').forEach(n=>n.toggleAttribute('hidden',l==='en'?n.classList.contains('zh'):n.classList.contains('en')));localStorage.setItem('laconicleon-language',l)};document.querySelector('#lang')?.addEventListener('click',()=>{l=l==='en'?'zh':'en';r()});r();</script>
</BaseLayout>
<style>[hidden]{display:none!important}main{max-width:1450px;margin:auto;padding:0 42px}header{height:105px;display:flex;align-items:center;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:16px;font:500 31px var(--display)}.brand img{width:38px;height:55px;object-fit:contain}nav{display:flex;gap:43px;margin-left:auto;font:16px var(--serif)}nav a{padding:11px 0;border-bottom:2px solid transparent}.active{color:var(--accent);border-color:var(--accent)}button{margin-left:42px;border:0;background:none;cursor:pointer;font:14px var(--mono)}button i{color:var(--accent);font-style:normal}.hero{display:grid;grid-template-columns:1fr 1.13fr;gap:8%;padding:75px 4% 66px;border-bottom:1px solid var(--ink)}.hero p,.label{font:13px var(--mono);color:var(--accent);margin:0 0 17px}.hero h1{font:500 clamp(42px,4.7vw,67px)/1.2 var(--serif);letter-spacing:-.06em;margin:0 0 28px;text-wrap:balance;word-break:keep-all}.hero span{font:19px/1.7 var(--serif);color:var(--muted)}figure{margin:0;overflow:hidden;border:1px solid var(--ink);height:395px}figure img{width:100%;height:100%;object-fit:cover;object-position:50% 34%;transform:scale(1.42);filter:grayscale(1) contrast(1.1)}.details{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--ink)}.details>div{padding:40px 12% 48px 8%;font:18px/1.8 var(--serif)}.details>div+div{border-left:1px solid var(--ink)}.details p:not(.label){margin:0}.details ul{margin:0;padding:0;list-style:none}.details li{padding:8px 0;border-bottom:1px solid var(--line)}.values{padding:39px 4% 50px;border-bottom:1px solid var(--ink)}ol{display:grid;grid-template-columns:repeat(4,1fr);padding:0;margin:28px 0 0;list-style:none}li b{display:block;color:var(--accent);font:18px var(--mono);margin-bottom:14px}ol li{padding:0 25px;border-left:1px solid var(--line);font:17px/1.6 var(--serif)}ol li:first-child{border:0;padding-left:0}footer{padding:34px 4% 58px}footer a{display:inline-block;margin-right:32px;font:18px var(--serif);border-bottom:1px solid var(--ink);padding-bottom:5px}footer b{color:var(--accent)}@media(max-width:760px){main{padding:0 20px}header{height:75px}.brand{font-size:25px}.brand img{width:29px;height:43px}nav{display:none}button{margin-left:auto}.hero{display:block;padding:51px 0}.hero h1{font-size:46px}figure{height:250px;margin-top:42px}.details{display:block}.details>div{padding:28px 0}.details>div+div{border:0;border-top:1px solid var(--ink)}ol{grid-template-columns:1fr 1fr;gap:27px}ol li:nth-child(3){border:0;padding-left:0}ol li{padding-left:18px}footer{padding:30px 0}}</style>
