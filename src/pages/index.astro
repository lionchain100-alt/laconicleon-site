---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 4);
---
<BaseLayout title="laconicleon — Leon Reed / 简练">
  <main>
    <header class="header"><a class="brand" href="#top"><img src="/brand-seal-vertical.png" alt="練字篆书印章" /><span>laconicleon</span></a><nav><a href="#writing">写作</a><a href="#projects">项目</a><a href="#about">关于</a><a href="#now">Now</a></nav><button class="language" id="lang-toggle"><span class="zh">中</span><span class="en" hidden>EN</span><i>/</i><span class="zh">EN</span><span class="en" hidden>中</span></button></header>
    <section class="hero" id="top"><div class="hero-copy"><h1 class="zh">把复杂的事，<br />说得简练。<em class="proof"></em></h1><h1 class="en" hidden>Make complex<br />things clear.<em class="proof"></em></h1><p class="tagline">Notes for clearer thinking.<span></span></p><p class="identity">Leon Reed <b>/</b> 简练</p><a class="text-link" href="#writing"><span class="zh">阅读文章</span><span class="en" hidden>Read writing</span> <b>→</b></a></div><figure><img src="/ink-paper.png" alt="墨迹与纸张的抽象构图" /></figure></section>
    <section class="writing" id="writing"><div class="rail-label"><span class="zh">阅读文章</span><span class="en" hidden>Writing</span><i></i></div><div class="post-list">{posts.map((post,index) => <a class="post" href={`/writing/${post.id}`}><span class="index">{String(index + 1).padStart(2, '0')}</span><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><time>{post.data.publishedAt.toLocaleDateString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}).replaceAll('/','.')}</time><b>→</b></a>)}</div></section>
    <section class="project" id="projects"><div class="rail-label"><span class="zh">查看项目</span><span class="en" hidden>Projects</span><i></i></div><div class="project-copy"><h2>纸的语言 <span>/</span> The Language of Paper</h2><p>一个关于纸张、书写与思考方式的持续实验。它从材料出发，试着把抽象的想法重新变得可触摸。</p><a class="text-link" href="#about"><span class="zh">查看项目</span><span class="en" hidden>View project</span> <b>→</b></a></div><figure><img src="/ink-paper.png" alt="纸张上的黑色笔触" /></figure></section>
    <section class="closing" id="about"><div><p>关于</p><span class="zh">我是 Leon Reed，也写作「简练」。<br />关注清晰的表达、长期有效的系统，以及值得被认真完成的事。</span><span class="en" hidden>I am Leon Reed, writing as 简练.<br />I care about clear expression, durable systems, and work done with attention.</span><a href="#now"><span class="zh">了解更多</span><span class="en" hidden>More about me</span> →</a></div><div id="now"><p>Now</p><span class="zh">正在整理这个网站，也在重新建立自己的写作节奏。<br />把零散笔记写成完整的文章。</span><span class="en" hidden>Building this site and returning to a steadier writing rhythm.<br />Turning fragments into finished essays.</span></div></section>
    <footer><span>© 2026 laconicleon. All rights reserved.</span><span>写作以澄明 · 项目以简练 · 思考以诚实</span></footer>
  </main>
  <script>const button=document.querySelector('#lang-toggle');button?.addEventListener('click',()=>{const toEnglish=document.documentElement.lang!=='en';document.documentElement.lang=toEnglish?'en':'zh-CN';document.querySelectorAll('.zh,.en').forEach(node=>node.toggleAttribute('hidden',toEnglish?node.classList.contains('zh'):node.classList.contains('en')));});</script>
</BaseLayout>
<style>
main{max-width:1520px;margin:0 auto;padding:0 46px}.header{height:77px;border-bottom:2px solid var(--ink);display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{display:flex;align-items:center;gap:15px;font:500 30px var(--display);letter-spacing:-1.2px}.brand img{width:48px;height:48px;object-fit:contain;filter:saturate(.98)}nav{display:flex;gap:48px;font:500 16px var(--serif)}nav a{position:relative}nav a::before{content:'';position:absolute;left:-25px;top:50%;width:1px;height:20px;background:var(--ink);transform:translateY(-50%)}nav a:first-child::before{display:none}.language{justify-self:end;border:0;background:transparent;padding:8px 0;cursor:pointer;font:500 14px var(--sans)}.language i{padding:0 7px;font-style:normal}.hero{display:grid;grid-template-columns:2fr 1fr;min-height:620px;border-bottom:1px solid var(--ink)}.hero-copy{padding:88px 4vw 58px 10px}.hero h1{font:500 clamp(54px,5.35vw,84px)/1.18 var(--serif);letter-spacing:-.075em;margin:0}.proof{display:inline-block;width:34px;height:24px;margin-left:9px;border:2px solid #bd2d2d;border-radius:50%;transform:rotate(-26deg);vertical-align:middle}.tagline{font:500 clamp(29px,2.7vw,44px)/1.2 var(--display);margin:25px 0 36px}.tagline span{display:block;width:315px;max-width:68%;border-bottom:2px solid #bd2d2d;transform:rotate(-1.4deg);margin:8px 0 0 4px}.identity{font:500 24px var(--serif);margin:0 0 57px}.identity b{color:var(--accent);padding:0 5px}.text-link{color:var(--accent);border-bottom:1px solid var(--accent);padding-bottom:7px;font:500 15px var(--serif)}.text-link b{font:400 20px var(--sans);margin-left:10px}.hero figure,.project figure{margin:0;overflow:hidden}.hero img{width:100%;height:100%;object-fit:cover;display:block}.writing{display:grid;grid-template-columns:15% 1fr;border-bottom:1px solid var(--ink)}.rail-label{padding:29px 20px 0 10px;font:500 17px var(--serif)}.rail-label i{display:block;width:31px;border-bottom:1px solid var(--ink);margin-top:15px}.post-list{border-left:1px solid var(--ink)}.post{min-height:94px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:70px 1fr 105px 25px;align-items:center;gap:12px;padding:11px 16px;transition:background .2s}.post:last-child{border:0}.post:hover{background:#f7f7f7}.index,time{font:400 13px var(--mono)}.index{font-size:25px}.post h2{font:500 21px var(--serif);margin:0}.post p{color:var(--muted);font:14px var(--serif);margin:5px 0 0}.post>b{color:var(--accent);font:400 24px var(--sans)}.project{display:grid;grid-template-columns:15% 28% 1fr;min-height:228px;border-bottom:1px solid var(--ink)}.project-copy{padding:25px 35px 24px 0}.project-copy h2{font:500 28px/1.25 var(--serif);margin:0}.project-copy h2 span{color:var(--accent)}.project-copy p{font:15px/1.65 var(--serif);color:#4e504f;margin:15px 0 21px}.project figure{height:158px;align-self:center}.project img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1) contrast(1.07)}.closing{display:grid;grid-template-columns:1fr 1fr;min-height:126px;border-bottom:1px solid var(--ink)}.closing>div{padding:20px 24px 20px 10px;font:16px/1.7 var(--serif)}.closing>div+div{border-left:1px solid var(--ink)}.closing p{font:500 17px var(--serif);margin:0 0 6px}.closing a{display:block;color:var(--accent);margin-top:4px}footer{display:flex;justify-content:space-between;padding:18px 8px 36px;font:12px var(--serif);color:#424444}[hidden]{display:none!important}@media(max-width:800px){main{padding:0 18px}.header{height:64px;grid-template-columns:1fr auto}.brand{gap:8px;font-size:24px}.brand img{width:37px;height:37px}nav{display:none}.hero{display:block;min-height:0}.hero-copy{padding:57px 0 39px}.hero h1{font-size:clamp(43px,12vw,56px)}.tagline{font-size:28px;margin:22px 0 27px}.identity{font-size:19px;margin-bottom:37px}.hero figure{height:370px}.writing{display:block}.rail-label{padding:39px 0 18px}.post-list{border-left:0}.post{grid-template-columns:39px 1fr 16px;padding:14px 0;min-height:0}.post time{display:none}.index{font-size:16px}.post h2{font-size:16px}.post p{font-size:12px}.project{grid-template-columns:1fr;border-bottom:0}.project .rail-label{padding-bottom:22px}.project-copy{padding:0 0 31px}.project-copy h2{font-size:26px}.project figure{height:240px}.closing{display:block;margin-top:47px}.closing>div{padding:20px 0}.closing>div+div{border-left:0;border-top:1px solid var(--line)}footer{display:block;line-height:1.8;padding-bottom:25px}footer span:last-child{display:block;margin-top:9px}.proof{width:23px;height:17px;margin-left:4px}}
.brand img{width:36px;height:50px}@media(max-width:800px){.brand img{width:27px;height:40px}}
</style>
