---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).filter((post) => !post.data.draft).sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latest = posts[0];
---
<BaseLayout title="laconicleon — Leon Reed / 简练">
<main>
  <header><a class="brand" href="/"><img src="/brand-seal-vertical.png" alt="练"/><span>laconicleon</span></a><nav><a href="#writing">写作</a><a href="#about">关于</a><a href="#now">Now</a></nav><button id="lang" aria-label="switch language">中 <i>/</i> EN</button></header>
  <section class="hero"><div><h1 class="zh">文字是日常的练习，<br/>也是与世界的往复。</h1><h1 class="en" hidden>Writing is a daily practice,<br/>a way to return to the world.</h1><a href="#writing">阅读最新文章 <b>→</b></a></div><figure><img src="/ink-paper.png" alt="黑白水墨"/></figure></section>
  {latest && <section class="featured" data-language={latest.data.language}><time>{latest.data.publishedAt.toLocaleDateString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}).replaceAll('/','.')}</time><div><small>最新文章</small><h2>{latest.data.title}</h2><p>{latest.data.description}</p><a href={`/writing/${latest.id}`}>阅读全文 <b>→</b></a></div></section>}
  <section class="archive" id="writing"><div class="label"><span class="zh">文章档案</span><span class="en" hidden>Writing archive</span></div><div>{posts.slice(1).map((post) => <a class="row" data-language={post.data.language} href={`/writing/${post.id}`}><time>{post.data.publishedAt.toLocaleDateString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}).replaceAll('/','.')}</time><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><b>→</b></a>)}</div></section>
  <section class="now" id="about"><p>关于</p><h2>Leon Reed <em>/</em> 简练</h2><span class="zh">写关于清晰表达、长期系统，和值得被认真完成的事。</span><span class="en" hidden>Writing about clear expression, durable systems, and work done with attention.</span></section>
  <section class="now" id="now"><p>Now</p><span class="zh">正在重新建立自己的写作节奏，把零散笔记写成完整文章。</span><span class="en" hidden>Returning to a steadier writing rhythm, turning fragments into finished essays.</span></section>
  <footer>© 2026 laconicleon <span>写作以澄明 · 项目以简练 · 思考以诚实</span></footer>
</main>
<script>const apply=(lang)=>{document.documentElement.lang=lang==='en'?'en':'zh-CN';document.querySelectorAll('.zh,.en').forEach(n=>n.toggleAttribute('hidden',lang==='en'?n.classList.contains('zh'):n.classList.contains('en')));document.querySelectorAll('[data-language]').forEach(n=>n.toggleAttribute('hidden',n.dataset.language!==lang));localStorage.setItem('laconicleon-language',lang)};apply(localStorage.getItem('laconicleon-language')||'zh');document.querySelector('#lang')?.addEventListener('click',()=>apply(document.documentElement.lang==='en'?'zh':'en'));</script>
</BaseLayout>
<style>main{max-width:1450px;margin:auto;padding:0 42px}header{height:105px;border-bottom:1px solid var(--ink);display:flex;align-items:center}.brand{display:flex;align-items:center;gap:16px;font:500 31px var(--display)}.brand img{width:38px;height:55px;object-fit:contain}nav{display:flex;gap:48px;margin-left:auto;font:16px var(--serif)}nav a+ a{border-left:1px solid var(--ink);padding-left:48px}button{margin-left:45px;border:0;background:transparent;font:14px var(--mono);cursor:pointer}button i{font-style:normal;color:var(--accent)}.hero{display:grid;grid-template-columns:42% 58%;min-height:405px;border-bottom:1px solid var(--ink)}.hero>div{padding:78px 28px 30px 7%}.hero h1{font:500 clamp(42px,4.5vw,72px)/1.25 var(--serif);letter-spacing:-.06em;margin:0 0 42px}.hero a,.featured a{color:var(--accent);font:15px var(--serif);border-bottom:1px solid var(--accent);padding-bottom:6px}.hero b,.featured b,.row>b{font:22px var(--sans);margin-left:12px}.hero figure{margin:30px 0 30px 20px;overflow:hidden}.hero img{width:100%;height:100%;display:block;object-fit:cover;filter:grayscale(1) contrast(1.12)}.featured{display:grid;grid-template-columns:180px 1fr;border-bottom:1px solid var(--ink);padding:28px 6% 35px}.featured time{font:22px var(--mono);color:var(--accent);line-height:1.3}.featured small{color:var(--accent);font:12px var(--mono)}.featured h2{font:500 clamp(31px,3.8vw,57px)/1.22 var(--serif);margin:12px 0}.featured p,.row p{color:var(--muted);font:16px/1.65 var(--serif);margin:0 0 17px}.archive{display:grid;grid-template-columns:180px 1fr;border-bottom:1px solid var(--ink)}.label{padding:31px 0 0 7%;font:17px var(--serif)}.archive>div{border-left:1px solid var(--ink)}.row{display:grid;grid-template-columns:125px 1fr 30px;gap:20px;align-items:center;padding:24px 29px;border-bottom:1px solid var(--line)}.row:last-child{border:0}.row:hover{background:#fafafa}.row time{font:12px var(--mono);color:var(--accent)}.row h2{font:500 25px var(--serif);margin:0}.now{display:inline-block;vertical-align:top;width:49%;min-height:165px;padding:30px 7% 36px 12%;border-bottom:1px solid var(--ink);font:17px/1.7 var(--serif)}.now+ .now{border-left:1px solid var(--ink)}.now p{margin:0 0 12px;color:var(--accent);font:12px var(--mono)}.now h2{font:500 26px var(--serif);margin:0 0 7px}.now em{color:var(--accent);font-style:normal}footer{padding:20px 0 36px;font:12px var(--serif)}footer span{float:right}@media(max-width:760px){main{padding:0 20px}header{height:75px}.brand{font-size:25px}.brand img{width:29px;height:43px}nav{display:none}button{margin-left:auto}.hero{display:block}.hero>div{padding:58px 0 38px}.hero h1{font-size:45px}.hero figure{height:250px;margin:0 0 28px}.featured,.archive{display:block}.featured{padding:25px 0}.featured time{display:block;margin-bottom:22px}.label{padding:28px 0 14px}.archive>div{border-left:0}.row{grid-template-columns:1fr 20px;padding:20px 0}.row time{display:none}.row h2{font-size:20px}.now{display:block;width:100%;padding:25px 0}.now+.now{border-left:0}footer span{float:none;display:block;margin-top:10px}}</style>
