---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latestZh = posts.find((post) => post.data.language === 'zh');
const latestEn = posts.find((post) => post.data.language === 'en');
---

<BaseLayout title="此刻 — laconicleon" description="Leon Reed / 简练此刻正在做的事。">
  <main>
    <SiteHeader active="now" />
    <section class="hero">
      <p class="label"><span class="zh">此刻</span><span class="en" hidden>Now</span></p>
      <h1><span class="zh">把零散的笔记，<br/>写成完整的文章。</span><span class="en" hidden>Turning fragments<br/>into finished essays.</span></h1>
      <p class="body zh">我正在重新建立稳定的写作节奏：读、记、整理、发布。这里会持续更新我正在投入的方向。</p>
      <p class="body en" hidden>I am rebuilding a steadier writing rhythm: read, note, shape, publish. This page changes with what I am paying attention to now.</p>
    </section>
    <figure class="now-lion"><img src="/ink-lion-now.png" alt="行走的水墨狮子"/></figure>
    <div class="grid">
      <div>
        <p class="label"><span class="zh">正在做</span><span class="en" hidden>Making</span></p>
        <h2 class="zh">让这个网站成为一个真正可生长的写作空间。</h2>
        <h2 class="en" hidden>Making this site a writing space that can grow over time.</h2>
      </div>
      <div>
        <p class="label"><span class="zh">正在学习</span><span class="en" hidden>Learning</span></p>
        <h2 class="zh">把清晰的产品体验、内容系统与个人表达放到同一个长期项目里。</h2>
        <h2 class="en" hidden>Bringing product experience, content systems, and personal expression into one long-term practice.</h2>
      </div>
      <div>
        <p class="label"><span class="zh">最近发布</span><span class="en" hidden>Latest</span></p>
        {latestZh && <a class="zh" href={`/writing/${latestZh.id}`}>{latestZh.data.title}<b>→</b></a>}
        {latestEn && <a class="en" href={`/writing/${latestEn.id}`} hidden>{latestEn.data.title}<b>→</b></a>}
      </div>
    </div>
    <SiteFooter><span class="zh">最后更新：2026 年 8 月</span><span class="en" hidden>Last updated: August 2026</span></SiteFooter>
  </main>
</BaseLayout>

<style>
  [hidden]{display:none!important}
  main{max-width:1450px;margin:auto;padding:0 42px}
  .label{color:var(--accent);font-style:normal}
  .hero{padding:92px 8% 76px;border-bottom:1px solid var(--ink)}
  .label{font:13px var(--mono);margin:0 0 20px}
  h1{font:500 clamp(50px,6.3vw,88px)/1.16 var(--serif);letter-spacing:-.07em;margin:0}
  .body{max-width:600px;margin:35px 0 0;color:var(--muted);font:19px/1.75 var(--serif)}
  .now-lion{height:275px;margin:0;overflow:hidden;border-bottom:1px solid var(--ink)}
  .now-lion img{width:100%;height:100%;object-fit:cover;object-position:center 72%;filter:grayscale(1) contrast(1.08)}
  .grid{display:grid;grid-template-columns:1fr 1fr 1fr;border-bottom:1px solid var(--ink)}
  .grid>div{min-height:240px;padding:36px 10%;border-left:1px solid var(--ink)}
  .grid>div:first-child{border-left:0}
  .grid h2{font:500 25px/1.5 var(--serif);margin:0}
  .grid a{display:flex;justify-content:space-between;border-bottom:1px solid var(--accent);padding-bottom:9px;color:var(--accent);font:20px/1.45 var(--serif)}
  .grid b{font:24px var(--sans);font-weight:400}
  .site-footer{padding:24px 8% 52px;color:var(--muted);font:12px var(--mono)}
  @media(max-width:760px){main{padding:0 20px}.hero{padding:60px 0}h1{font-size:51px}.now-lion{height:190px}.grid{display:block}.grid>div{min-height:0;padding:29px 0;border-left:0;border-top:1px solid var(--ink)}.grid>div:first-child{border-top:0}.site-footer{padding:22px 0 45px}}
</style>
