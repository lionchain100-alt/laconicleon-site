---
interface Props {
  title?: string;
  description?: string;
  lang?: 'zh-CN' | 'en';
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  indexable?: boolean;
}

const siteUrl = 'https://laconicleon.com';
const {
  title = 'laconicleon — Leon Reed / 简练',
  description = 'Notes, systems, and things worth making.',
  lang = 'zh-CN',
  canonicalPath = Astro.url.pathname,
  image = '/ink-lion-hero.png',
  type = 'website',
  indexable = true,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const locale = lang === 'en' ? 'en_US' : 'zh_CN';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="laconicleon" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/png" href="/brand-seal-vertical.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Noto+Serif+SC:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root { --ink:#121414; --muted:#6d7470; --line:#cfd3d1; --accent:#bd2d2d; --paper:#fff; --serif:'Noto Serif SC','Songti SC',serif; --display:'Playfair Display',var(--serif); --sans:'DM Sans','PingFang SC','Microsoft YaHei',sans-serif; --mono:'DM Mono',monospace; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; background:var(--paper); }
  body { margin:0; color:var(--ink); background:var(--paper); font-family:var(--sans); }
  a { color:inherit; text-decoration:none; }
  button { font:inherit; }
</style>
