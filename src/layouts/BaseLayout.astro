---
interface Props { title?: string; description?: string }
const { title = 'laconicleon — Leon Reed / 简练', description = 'Notes, systems, and things worth making.' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/brand-seal-vertical.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Noto+Serif+SC:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root { --ink:#121414; --muted:#6d7470; --line:#cfd3d1; --accent:#bd2d2d; --paper:#fff; --serif:'Noto Serif SC','Songti SC',serif; --display:'Playfair Display',var(--serif); --sans:'DM Sans','PingFang SC','Microsoft YaHei',sans-serif; --mono:'DM Mono',monospace; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; background:var(--paper); }
  body { margin:0; color:var(--ink); background:var(--paper); font-family:var(--sans); }
  a { color:inherit; text-decoration:none; }
  button { font:inherit; }
</style>
